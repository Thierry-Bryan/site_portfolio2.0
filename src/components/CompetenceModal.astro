---
// Modal pour afficher les détails d'une compétence
---

<div
  id="competence-modal"
  class="modal-overlay fixed inset-0 z-[9999] hidden items-center justify-center p-4 overflow-y-auto"
  onclick="closeCompetenceModal()"
>
  <div
    id="competence-modal-container"
    class="modal-container relative w-full max-w-2xl my-auto"
    onclick="event.stopPropagation()"
  >
    <!-- Modal Card -->
    <div
      id="competence-modal-card"
      class="modal-card relative bg-[var(--b1)] border-4 border-[var(--bc)] p-6 md:p-12 modal-shadow-primary"
    >
      <!-- Bouton fermer -->
      <button
        type="button"
        id="close-competence-modal"
        onclick="closeCompetenceModal()"
        class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center border-2 border-[var(--bc)] bg-[var(--b1)] hover:bg-[var(--p)] hover:border-[var(--p)] transition-all duration-300 group z-50"
        aria-label="Fermer"
      >
        <svg
          class="w-5 h-5 text-[var(--bc)] group-hover:text-[var(--b1)] transition-colors pointer-events-none"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="3"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Ligne décorative -->
      <div class="absolute top-0 left-0 w-full h-2 bg-[var(--p)]"></div>

      <!-- Logo -->
      <div class="flex justify-center mb-6 mt-4">
        <div
          class="w-24 h-24 border-2 border-[var(--bc)] bg-[var(--b1)] flex items-center justify-center p-4"
        >
          <img
            id="competence-modal-logo"
            src=""
            alt=""
            class="max-w-full max-h-full object-contain"
          />
        </div>
      </div>

      <!-- Name -->
      <h2
        id="competence-modal-name"
        class="text-3xl md:text-4xl font-primary text-[var(--p)] mb-3 uppercase tracking-tight text-center"
      >
      </h2>

      <!-- Category -->
      <div class="flex justify-center mb-6">
        <span
          id="competence-modal-category"
          class="inline-block px-4 py-2 border-2 border-[var(--bc)] bg-[var(--b1)] text-[var(--bc)] font-primary text-xs uppercase tracking-wide"
        >
        </span>
      </div>

      <!-- Description -->
      <div class="text-center">
        <p id="competence-modal-description" class="text-[var(--bc)] leading-relaxed font-medium">
        </p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  function openCompetenceModal(name, logo, category, description, theme) {
    const modal = document.getElementById("competence-modal");
    const modalCard = document.getElementById("competence-modal-card");

    if (modal && modalCard) {
      // Appliquer le thème au modal
      const isDarkMode = localStorage.getItem("darkMode") === "true";
      const modalTheme = isDarkMode ? theme + "-dark" : theme;

      modal.setAttribute("data-theme", modalTheme);
      modalCard.setAttribute("data-theme", modalTheme);

      // Remplir le contenu
      document.getElementById("competence-modal-logo").src = logo;
      document.getElementById("competence-modal-logo").alt = name;
      document.getElementById("competence-modal-name").textContent = name;
      document.getElementById("competence-modal-category").textContent = category;
      document.getElementById("competence-modal-description").textContent = description;

      // Afficher le modal
      modal.classList.add("show");
      document.body.style.overflow = "hidden";
    }
  }

  function closeCompetenceModal() {
    const modal = document.getElementById("competence-modal");

    if (modal) {
      modal.classList.remove("show");
      document.body.style.overflow = "";
    }
  }

  // Fermer avec Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && document.getElementById("competence-modal")?.classList.contains("show")) {
      closeCompetenceModal();
    }
  });
</script>

<style>
  .modal-overlay {
    transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .modal-overlay.show {
    display: flex !important;
    animation: fadeIn 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slideUp {
    from {
      transform: translateY(30px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .modal-container {
    animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .modal-shadow-primary {
    box-shadow: -8px 8px 0 0 var(--bc);
  }

  .modal-card {
    position: relative;
  }

  /* Fond flouté et assombri */
  .modal-overlay {
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .modal-container {
    position: relative;
    z-index: 1;
  }
</style>

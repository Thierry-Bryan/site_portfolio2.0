---
// Modal pour afficher les détails d'une compétence
---

<div
  id="competence-modal"
  class="fixed inset-0 z-[9999] hidden items-center justify-center p-4 overflow-y-auto bg-black/30 backdrop-blur-md opacity-0 transition-opacity duration-400"
  onclick="closeCompetenceModal()"
>
  <div
    id="competence-modal-container"
    class="relative w-full max-w-2xl my-auto translate-y-8 opacity-0 transition-all duration-500"
    onclick="event.stopPropagation()"
  >
    <!-- Modal Card -->
    <div
      id="competence-modal-card"
      class="relative bg-[var(--b1)] border-4 border-[var(--bc)] p-6 md:p-12"
      style="box-shadow: -8px 8px 0 0 var(--bc);"
    >
      <!-- Bouton fermer -->
      <button
        type="button"
        id="close-competence-modal"
        onclick="closeCompetenceModal()"
        class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center border-2 border-[var(--p)] bg-[var(--b1)] hover:bg-[var(--p)] hover:border-[var(--p)] transition-all duration-300 group z-50 cursor-pointer"
        style="box-shadow: -3px 3px 0 0 var(--bc);"
        aria-label="Fermer"
      >
        <svg
          class="w-5 h-5 text-[var(--p)] group-hover:text-[var(--b1)] transition-colors pointer-events-none"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="3"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Ligne décorative -->
      <div class="absolute top-0 left-0 w-full h-2 bg-[var(--p)]"></div>

      <!-- Logo -->
      <div class="flex justify-center mt-4">
        <div class="w-24 h-24 flex items-center justify-center p-4">
          <img
            id="competence-modal-logo"
            src=""
            alt=""
            class="max-w-full max-h-full object-contain"
          />
        </div>
      </div>

      <!-- Name -->
      <h2
        id="competence-modal-name"
        class="text-3xl md:text-4xl font-primary text-[var(--p)] mb-3 uppercase tracking-tight text-center"
      >
      </h2>

      <!-- Category -->
      <div class="flex justify-center mb-6">
        <span
          id="competence-modal-category"
          class="inline-block px-4 py-2 border-2 border-[var(--bc)] bg-[var(--b1)] text-[var(--bc)] font-primary text-xs uppercase tracking-wide"
        >
        </span>
      </div>

      <!-- Description -->
      <div class="text-center">
        <p
          id="competence-modal-description"
          class="text-[var(--bc)] leading-relaxed font-medium"
        >
        </p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  function openCompetenceModal(name, logo, category, description, theme) {
    const modal = document.getElementById("competence-modal");
    const modalCard = document.getElementById("competence-modal-card");
    const modalContainer = document.getElementById(
      "competence-modal-container",
    );

    if (modal && modalCard && modalContainer) {
      // Appliquer le thème au modal
      modal.setAttribute("data-theme", theme);
      modalCard.setAttribute("data-theme", theme);

      // Remplir le contenu
      const logoImg = document.getElementById("competence-modal-logo");
      logoImg.src = logo;
      logoImg.alt = name;

      document.getElementById("competence-modal-name").textContent = name;
      document.getElementById("competence-modal-category").textContent =
        category;
      document.getElementById("competence-modal-description").innerHTML =
        description;

      // Afficher le modal avec animation
      modal.classList.remove("hidden");
      document.body.style.overflow = "hidden";

      // Forcer un reflow pour que l'animation fonctionne
      modal.offsetHeight;

      // Ajouter les classes d'animation
      modal.classList.remove("opacity-0");
      modal.classList.add("flex", "opacity-100");
      modalContainer.classList.remove("translate-y-8", "opacity-0");
      modalContainer.classList.add("translate-y-0", "opacity-100");
    }
  }

  function closeCompetenceModal() {
    const modal = document.getElementById("competence-modal");
    const modalContainer = document.getElementById(
      "competence-modal-container",
    );

    if (modal && modalContainer) {
      // Animer la fermeture
      modal.classList.remove("opacity-100");
      modal.classList.add("opacity-0");
      modalContainer.classList.remove("translate-y-0", "opacity-100");
      modalContainer.classList.add("translate-y-8", "opacity-0");

      // Cacher après l'animation
      setTimeout(() => {
        modal.classList.remove("flex");
        modal.classList.add("hidden");
        document.body.style.overflow = "";
      }, 400);
    }
  }

  // Fermer avec Escape
  document.addEventListener("keydown", (e) => {
    if (
      e.key === "Escape" &&
      document.getElementById("competence-modal")?.classList.contains("flex")
    ) {
      closeCompetenceModal();
    }
  });
</script>

---
// Dashboard admin - Page protégée
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Admin - Dashboard" theme="basique">
  <div id="admin-content" class="hidden">
    <!-- Sidebar -->
    <aside class="fixed left-0 top-0 h-screen w-64 bg-gray-900 text-white flex flex-col">
      <div class="p-6 border-b border-gray-800">
        <h1 class="text-xl font-bold">Portfolio Admin</h1>
      </div>
      
      <nav class="flex-1 p-4 space-y-1">
        <a href="/admin/dashboard" class="block px-4 py-3 bg-gray-800 rounded text-white font-medium">
          Dashboard
        </a>
        <a href="/admin/themes" class="block px-4 py-3 hover:bg-gray-800 rounded transition-colors">
          Thèmes
        </a>
        <a href="/admin/tags" class="block px-4 py-3 hover:bg-gray-800 rounded transition-colors">
          Tags
        </a>
        <a href="/admin/technologies" class="block px-4 py-3 hover:bg-gray-800 rounded transition-colors">
          Technologies
        </a>
      </nav>

      <div class="p-4 border-t border-gray-800">
        <button
          id="logout-btn"
          class="w-full px-4 py-2 bg-red-600 hover:bg-red-700 rounded text-white transition-colors"
        >
          Déconnexion
        </button>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="ml-64 min-h-screen bg-gray-50">
      <div class="p-8">
        <div class="mb-8">
          <h2 class="text-3xl font-bold text-gray-900 mb-2">Dashboard</h2>
          <p class="text-gray-600">Vue d'ensemble de votre portfolio</p>
        </div>

        <!-- Stats rapides -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
          <div class="bg-white p-6 rounded-lg shadow">
            <div class="text-3xl font-bold text-blue-600 mb-1" id="stat-projets">-</div>
            <div class="text-sm text-gray-600">Projets</div>
          </div>
          <div class="bg-white p-6 rounded-lg shadow">
            <div class="text-3xl font-bold text-purple-600 mb-1" id="stat-themes">-</div>
            <div class="text-sm text-gray-600">Thèmes</div>
          </div>
          <div class="bg-white p-6 rounded-lg shadow">
            <div class="text-3xl font-bold text-green-600 mb-1" id="stat-tags">-</div>
            <div class="text-sm text-gray-600">Tags</div>
          </div>
          <div class="bg-white p-6 rounded-lg shadow">
            <div class="text-3xl font-bold text-orange-600 mb-1" id="stat-techs">-</div>
            <div class="text-sm text-gray-600">Technologies</div>
          </div>
        </div>

        <!-- Actions rapides -->
        <div class="bg-white rounded-lg shadow p-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Actions rapides</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <a
              href="/admin/themes"
              class="p-4 border-2 border-gray-200 rounded-lg hover:border-blue-500 hover:bg-blue-50 transition-all group"
            >
              <h4 class="font-semibold text-gray-900 mb-1 group-hover:text-blue-600">Gérer les thèmes</h4>
              <p class="text-sm text-gray-600">Créer et modifier les couleurs</p>
            </a>
            <a
              href="/admin/tags"
              class="p-4 border-2 border-gray-200 rounded-lg hover:border-green-500 hover:bg-green-50 transition-all group"
            >
              <h4 class="font-semibold text-gray-900 mb-1 group-hover:text-green-600">Gérer les tags</h4>
              <p class="text-sm text-gray-600">Catégories de projets</p>
            </a>
            <a
              href="/admin/technologies"
              class="p-4 border-2 border-gray-200 rounded-lg hover:border-orange-500 hover:bg-orange-50 transition-all group"
            >
              <h4 class="font-semibold text-gray-900 mb-1 group-hover:text-orange-600">Gérer les technologies</h4>
              <p class="text-sm text-gray-600">Stack technique</p>
            </a>
          </div>
        </div>

        <!-- Accès PocketBase -->
        <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
          <p class="text-sm text-blue-800 mb-2">
            <strong>Mode avancé :</strong> Pour gérer les projets et leurs médias, utilisez l'interface PocketBase
          </p>
          <a
            href="https://portfolio.bryan-thierry.fr/_/"
            target="_blank"
            class="inline-block px-4 py-2 bg-blue-600 text-white text-sm rounded hover:bg-blue-700 transition-colors"
          >
            Ouvrir PocketBase Admin
          </a>
        </div>
      </div>
    </main>
  </div>

  <!-- Message de chargement -->
  <div id="loading" class="min-h-screen flex items-center justify-center">
    <div class="text-2xl font-primary text-[var(--bc)]">Chargement...</div>
  </div>
</Layout>

<script>
  import PocketBase from "pocketbase";
  
  const pb = new PocketBase("https://portfolio.bryan-thierry.fr/");
  
  // Vérifier l'authentification
  if (!pb.authStore.isValid) {
    window.location.href = "/admin";
  } else {
    document.getElementById("loading")?.classList.add("hidden");
    document.getElementById("admin-content")?.classList.remove("hidden");
    
    // Charger les stats
    loadStats();
  }

  async function loadStats() {
    try {
      const [projets, themes, tags, techs] = await Promise.all([
        pb.collection("projets").getFullList(),
        pb.collection("themes").getFullList(),
        pb.collection("tags").getFullList(),
        pb.collection("technologies").getFullList(),
      ]);

      document.getElementById("stat-projets")!.textContent = projets.length.toString();
      document.getElementById("stat-themes")!.textContent = themes.length.toString();
      document.getElementById("stat-tags")!.textContent = tags.length.toString();
      document.getElementById("stat-techs")!.textContent = techs.length.toString();
    } catch (error) {
      console.error("Erreur chargement stats:", error);
    }
  }

  // Déconnexion
  document.getElementById("logout-btn")?.addEventListener("click", () => {
    pb.authStore.clear();
    window.location.href = "/admin";
  });
</script>
</Layout>

---
// Dashboard admin - Page protégée
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Admin - Dashboard" theme="basique">
  <div id="admin-content" class="hidden">
    <section class="min-h-screen bg-[var(--b1)] py-20 px-4">
      <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="flex justify-between items-center mb-12">
          <h1 class="text-5xl font-primary text-[var(--bc)]">
            ADMIN DASHBOARD
          </h1>
          <button
            id="logout-btn"
            class="px-6 py-3 bg-red-500 text-white font-primary border-2 border-[var(--bc)] hover:shadow-[4px_4px_0px_var(--bc)] transition-all"
          >
            DÉCONNEXION
          </button>
        </div>

        <!-- Stats rapides -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-12">
          <div class="border-4 border-[var(--bc)] p-6 bg-[var(--b1)]">
            <div class="text-4xl font-primary text-[var(--p)] mb-2" id="stat-projets">-</div>
            <div class="text-lg font-secondary text-[var(--bc)]">Projets</div>
          </div>
          <div class="border-4 border-[var(--bc)] p-6 bg-[var(--b1)]">
            <div class="text-4xl font-primary text-[var(--p)] mb-2" id="stat-themes">-</div>
            <div class="text-lg font-secondary text-[var(--bc)]">Thèmes</div>
          </div>
          <div class="border-4 border-[var(--bc)] p-6 bg-[var(--b1)]">
            <div class="text-4xl font-primary text-[var(--p)] mb-2" id="stat-tags">-</div>
            <div class="text-lg font-secondary text-[var(--bc)]">Tags</div>
          </div>
          <div class="border-4 border-[var(--bc)] p-6 bg-[var(--b1)]">
            <div class="text-4xl font-primary text-[var(--p)] mb-2" id="stat-techs">-</div>
            <div class="text-lg font-secondary text-[var(--bc)]">Technologies</div>
          </div>
        </div>

        <!-- Actions principales -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Gestion Projets -->
          <a
            href="/admin/projets"
            class="border-4 border-[var(--bc)] p-8 bg-[var(--b1)] hover:bg-[var(--p)] hover:text-[var(--b1)] transition-all group"
          >
            <h2 class="text-3xl font-primary mb-4">📁 PROJETS</h2>
            <p class="font-secondary text-lg">
              Créer, modifier et supprimer des projets
            </p>
          </a>

          <!-- Gestion Thèmes -->
          <a
            href="/admin/themes"
            class="border-4 border-[var(--bc)] p-8 bg-[var(--b1)] hover:bg-[var(--p)] hover:text-[var(--b1)] transition-all group"
          >
            <h2 class="text-3xl font-primary mb-4">🎨 THÈMES</h2>
            <p class="font-secondary text-lg">
              Gérer les palettes de couleurs avec color picker
            </p>
          </a>

          <!-- Gestion Tags -->
          <a
            href="/admin/tags"
            class="border-4 border-[var(--bc)] p-8 bg-[var(--b1)] hover:bg-[var(--p)] hover:text-[var(--b1)] transition-all group"
          >
            <h2 class="text-3xl font-primary mb-4">🏷️ TAGS</h2>
            <p class="font-secondary text-lg">
              Gérer les catégories de projets
            </p>
          </a>

          <!-- Gestion Technologies -->
          <a
            href="/admin/technologies"
            class="border-4 border-[var(--bc)] p-8 bg-[var(--b1)] hover:bg-[var(--p)] hover:text-[var(--b1)] transition-all group"
          >
            <h2 class="text-3xl font-primary mb-4">⚙️ TECHNOLOGIES</h2>
            <p class="font-secondary text-lg">
              Gérer les technologies et outils
            </p>
          </a>
        </div>

        <!-- Lien vers PocketBase Admin -->
        <div class="mt-12 text-center">
          <a
            href="https://portfolio.bryan-thierry.fr/_/"
            target="_blank"
            class="inline-block px-8 py-4 border-2 border-[var(--bc)] bg-[var(--b1)] text-[var(--bc)] font-secondary hover:bg-[var(--bc)] hover:text-[var(--b1)] transition-all"
          >
            🔧 Accéder au PocketBase Admin (avancé)
          </a>
        </div>
      </div>
    </section>
  </div>

  <!-- Message de chargement -->
  <div id="loading" class="min-h-screen flex items-center justify-center">
    <div class="text-2xl font-primary text-[var(--bc)]">Chargement...</div>
  </div>
</Layout>

<script>
  import PocketBase from "pocketbase";
  
  const pb = new PocketBase("https://portfolio.bryan-thierry.fr/");
  
  // Vérifier l'authentification
  if (!pb.authStore.isValid) {
    window.location.href = "/admin";
  } else {
    document.getElementById("loading")?.classList.add("hidden");
    document.getElementById("admin-content")?.classList.remove("hidden");
    
    // Charger les stats
    loadStats();
  }

  async function loadStats() {
    try {
      const [projets, themes, tags, techs] = await Promise.all([
        pb.collection("projets").getFullList(),
        pb.collection("themes").getFullList(),
        pb.collection("tags").getFullList(),
        pb.collection("technologies").getFullList(),
      ]);

      document.getElementById("stat-projets")!.textContent = projets.length.toString();
      document.getElementById("stat-themes")!.textContent = themes.length.toString();
      document.getElementById("stat-tags")!.textContent = tags.length.toString();
      document.getElementById("stat-techs")!.textContent = techs.length.toString();
    } catch (error) {
      console.error("Erreur chargement stats:", error);
    }
  }

  // Déconnexion
  document.getElementById("logout-btn")?.addEventListener("click", () => {
    pb.authStore.clear();
    window.location.href = "/admin";
  });
</script>
</Layout>

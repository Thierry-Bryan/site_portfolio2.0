---
import LayoutAdmin from "../../layouts/LayoutAdmin.astro";
---

<LayoutAdmin title="Admin - Tags">
  <div id="admin-content" class="hidden">
    <!-- Sidebar -->
    <aside class="fixed left-0 top-0 h-screen w-64 bg-black text-white flex flex-col z-50">
      <div class="p-6 border-b-2 border-white">
        <h1 class="text-xl font-bold uppercase">Portfolio Admin</h1>
      </div>
      <nav class="flex-1 p-4 space-y-1">
        <a href="/admin/dashboard" class="block px-4 py-2 hover:bg-white hover:text-black transition-colors uppercase text-sm">Dashboard</a>
        <a href="/admin/projets" class="block px-4 py-2 hover:bg-white hover:text-black transition-colors uppercase text-sm">Projets</a>
        <a href="/admin/themes" class="block px-4 py-2 hover:bg-white hover:text-black transition-colors uppercase text-sm">Thèmes</a>
        <a href="/admin/tags" class="block px-4 py-2 bg-white text-black uppercase text-sm font-bold">Tags</a>
        <a href="/admin/technologies" class="block px-4 py-2 hover:bg-white hover:text-black transition-colors uppercase text-sm">Technologies</a>
      </nav>
      <div class="p-4 border-t-2 border-white">
        <button id="logout-btn" class="w-full px-4 py-2 bg-red-600 hover:bg-red-700 text-white transition-colors uppercase text-sm font-bold">Déconnexion</button>
      </div>
    </aside>

    <main class="ml-64 min-h-screen bg-[#faf9f7]">
      <div class="p-8">
        <div class="flex justify-between items-center mb-8">
          <div>
            <h2 class="text-4xl font-bold text-black uppercase mb-2">Gestion des tags</h2>
            <p class="text-gray-700">Créer et gérer les catégories de projets</p>
          </div>
          <button id="new-tag-btn" class="px-6 py-3 bg-black text-white font-bold uppercase hover:bg-gray-800 transition-colors border-4 border-black">
            Nouveau tag
          </button>
        </div>

        <div id="tags-list" class="space-y-3"></div>

        <!-- Modal -->
        <div id="tag-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
          <div class="bg-white rounded-lg max-w-md w-full p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6" id="modal-title">Nouveau tag</h2>
            <form id="tag-form" class="space-y-6">
              <input type="hidden" id="tag-id" />
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Nom du tag <span class="text-red-500">*</span></label>
                <input
                  type="text"
                  id="tag-name"
                  required
                  placeholder="Ex: Web Design"
                  class="w-full px-4 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500"
                />
              </div>
              <div class="flex justify-end gap-3">
                <button type="button" id="cancel-btn" class="px-6 py-2 border border-gray-300 rounded hover:bg-gray-100">
                  Annuler
                </button>
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
                  Enregistrer
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>
  </div>
  <div id="loading" class="min-h-screen flex items-center justify-center">
    <div class="text-2xl font-primary text-[var(--bc)]">Chargement...</div>
  </div>
</Layout>

<script>
  import PocketBase from "pocketbase";
  const pb = new PocketBase("https://portfolio.bryan-thierry.fr/");
  
  if (!pb.authStore.isValid) {
    window.location.href = "/admin";
  } else {
    document.getElementById("loading")?.classList.add("hidden");
    document.getElementById("admin-content")?.classList.remove("hidden");
    loadTags();
  }

  async function loadTags() {
    const tags = await pb.collection("tags").getFullList({ sort: "name" });
    const container = document.getElementById("tags-list")!;
    container.innerHTML = tags.map(tag => `
      <div class="bg-white p-4 rounded-lg shadow hover:shadow-md transition-shadow flex justify-between items-center">
        <span class="text-lg font-semibold text-gray-900">${tag.name}</span>
        <div class="flex gap-2">
          <button onclick="editTag('${tag.id}')" class="px-4 py-2 bg-blue-600 text-white text-sm rounded hover:bg-blue-700">Modifier</button>
          <button onclick="deleteTag('${tag.id}', '${tag.name}')" class="px-4 py-2 bg-red-600 text-white text-sm rounded hover:bg-red-700">Supprimer</button>
        </div>
      </div>
    `).join('');
  }

  document.getElementById("new-tag-btn")?.addEventListener("click", () => {
    (document.getElementById("tag-form") as HTMLFormElement).reset();
    (document.getElementById("tag-id") as HTMLInputElement).value = "";
    document.getElementById("modal-title")!.textContent = "Nouveau tag";
    document.getElementById("tag-modal")?.classList.remove("hidden");
  });

  document.getElementById("cancel-btn")?.addEventListener("click", () => {
    document.getElementById("tag-modal")?.classList.add("hidden");
  });

  document.getElementById("tag-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const id = (document.getElementById("tag-id") as HTMLInputElement).value;
    const name = (document.getElementById("tag-name") as HTMLInputElement).value;
    
    try {
      if (id) {
        await pb.collection("tags").update(id, { name });
      } else {
        await pb.collection("tags").create({ name });
      }
      document.getElementById("tag-modal")?.classList.add("hidden");
      loadTags();
      alert("Tag enregistré !");
    } catch (error) {
      console.error(error);
      alert("Erreur lors de l'enregistrement");
    }
  });

  (window as any).editTag = async (id: string) => {
    const tag = await pb.collection("tags").getOne(id);
    (document.getElementById("tag-id") as HTMLInputElement).value = id;
    (document.getElementById("tag-name") as HTMLInputElement).value = tag.name;
    document.getElementById("modal-title")!.textContent = `MODIFIER ${tag.name.toUpperCase()}`;
    document.getElementById("tag-modal")?.classList.remove("hidden");
  };

  (window as any).deleteTag = async (id: string, name: string) => {
    if (!confirm(`Supprimer "${name}" ?`)) return;
    await pb.collection("tags").delete(id);
    loadTags();
  };

  document.getElementById("logout-btn")?.addEventListener("click", () => {
    pb.authStore.clear();
    window.location.href = "/admin";
  });
</script>
</Layout>

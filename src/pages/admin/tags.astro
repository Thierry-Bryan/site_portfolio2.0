---
import LayoutAdmin from "../../layouts/LayoutAdmin.astro";
---

<LayoutAdmin title="Admin - Tags">
  <div id="admin-content" class="hidden">
    <!-- Sidebar -->
    <aside class="fixed left-0 top-0 h-screen w-64 bg-black text-white flex flex-col z-50">
      <div class="p-6 border-b-2 border-white">
        <h1 class="text-xl font-medium uppercase tracking-wider">Portfolio Admin</h1>
      </div>
      <nav class="flex-1 p-4 space-y-1">
        <a href="/admin/dashboard" class="block px-4 py-2 hover:bg-white hover:text-black transition-colors uppercase text-sm">Dashboard</a>
        <a href="/admin/projets" class="block px-4 py-2 hover:bg-white hover:text-black transition-colors uppercase text-sm">Projets</a>
        <a href="/admin/themes" class="block px-4 py-2 hover:bg-white hover:text-black transition-colors uppercase text-sm">Thèmes</a>
        <a href="/admin/tags" class="block px-4 py-2 bg-white text-black uppercase text-sm font-medium">Tags</a>
        <a href="/admin/technologies" class="block px-4 py-2 hover:bg-white hover:text-black transition-colors uppercase text-sm">Technologies</a>
      </nav>
      <div class="p-4 border-t-2 border-white">
        <button id="logout-btn" class="w-full px-4 py-2 bg-red-600 hover:bg-red-700 text-white transition-colors uppercase text-sm">Déconnexion</button>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="ml-64 min-h-screen bg-[#faf9f7]">
      <div class="p-8">
        <!-- Header -->
        <div class="flex justify-between items-center mb-8">
          <div>
            <h2 class="text-4xl font-black text-black uppercase mb-2 tracking-wider">Tags</h2>
            <p class="text-gray-600 text-lg">Organisez vos projets par catégories visuelles</p>
          </div>
          <button id="new-tag-btn" class="px-6 py-3 bg-black text-white font-medium uppercase hover:bg-gray-800 transition-colors border-2 border-black">
            🏷️ Nouveau tag
          </button>
        </div>

        <!-- Tags Grid -->
        <div id="tags-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"></div>
      </div>
    </main>

    <!-- Modal -->
    <div id="tag-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
      <div class="bg-white border-4 border-black max-w-md w-full">
        <!-- Modal Header -->
        <div class="flex justify-between items-center p-6 border-b-4 border-black">
          <h2 class="text-2xl font-black text-black uppercase tracking-wider" id="modal-title">Nouveau tag</h2>
          <button id="close-modal" class="text-black text-4xl leading-none hover:text-gray-600">×</button>
        </div>

        <!-- Modal Content -->
        <div class="p-6">
          <form id="tag-form" class="space-y-6">
            <input type="hidden" id="tag-id" />

            <!-- Nom -->
            <div>
              <label class="block text-sm font-medium text-black mb-2 uppercase tracking-wide">
                Nom du tag <span class="text-red-600">*</span>
              </label>
              <input
                type="text"
                id="tag-name"
                required
                placeholder="Web Design, E-commerce, Portfolio..."
                class="w-full px-4 py-3 border-2 border-black bg-white text-black focus:outline-none focus:border-4"
              />
            </div>

            <!-- Couleur -->
            <div>
              <label class="block text-sm font-medium text-black mb-2 uppercase tracking-wide">
                Couleur du tag
              </label>
              <div class="flex gap-4 items-center">
                <input
                  type="color"
                  id="tag-color"
                  value="#000000"
                  class="w-12 h-12 border-2 border-black"
                />
                <input
                  type="text"
                  id="tag-color-hex"
                  placeholder="#000000"
                  class="flex-1 px-4 py-3 border-2 border-black bg-white text-black focus:outline-none focus:border-4"
                />
              </div>
              <div class="mt-3 p-3 border-2 border-gray-300">
                <span class="text-xs text-gray-600 uppercase tracking-wide">Aperçu :</span>
                <div class="mt-2">
                  <span id="tag-preview" class="inline-block px-3 py-1 text-white text-sm font-medium uppercase tracking-wide" style="background-color: #000000;">
                    Exemple de tag
                  </span>
                </div>
              </div>
            </div>

            <!-- Description -->
            <div>
              <label class="block text-sm font-medium text-black mb-2 uppercase tracking-wide">
                Description (optionnelle)
              </label>
              <textarea
                id="tag-description"
                rows="3"
                placeholder="Description du type de projets que ce tag représente..."
                class="w-full px-4 py-3 border-2 border-black bg-white text-black focus:outline-none focus:border-4"
              ></textarea>
            </div>

            <!-- Buttons -->
            <div class="flex gap-4 pt-6 border-t-2 border-black">
              <button
                type="submit"
                class="flex-1 px-6 py-3 bg-black text-white font-medium uppercase hover:bg-gray-800 transition-colors"
              >
                💾 Sauvegarder
              </button>
              <button
                type="button"
                id="cancel-btn"
                class="px-6 py-3 border-2 border-black text-black font-medium uppercase hover:bg-gray-100 transition-colors"
              >
                Annuler
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Loading -->
  <div id="loading" class="min-h-screen flex items-center justify-center bg-[#faf9f7]">
    <div class="text-2xl font-medium text-black">Chargement des tags...</div>
  </div>
</LayoutAdmin>

<script>
  import PocketBase from "pocketbase";

  const pb = new PocketBase("https://portfolio.bryan-thierry.fr/");

  // Vérifier l'authentification
  if (!pb.authStore.isValid) {
    window.location.href = "/admin";
  } else {
    document.getElementById("loading")?.classList.add("hidden");
    document.getElementById("admin-content")?.classList.remove("hidden");
    loadTags();
  }

  let tags = [];

  // Éléments DOM
  const modal = document.getElementById("tag-modal");
  const form = document.getElementById("tag-form");
  const colorPicker = document.getElementById("tag-color");
  const colorHex = document.getElementById("tag-color-hex");
  const tagPreview = document.getElementById("tag-preview");
  const tagNameInput = document.getElementById("tag-name");

  // Event Listeners
  document.getElementById("new-tag-btn")?.addEventListener("click", () => openModal());
  document.getElementById("close-modal")?.addEventListener("click", closeModal);
  document.getElementById("cancel-btn")?.addEventListener("click", closeModal);
  form?.addEventListener("submit", handleSubmit);

  // Sync color picker and preview
  colorPicker?.addEventListener("input", updatePreview);
  colorHex?.addEventListener("input", (e) => {
    if (/^#[0-9A-F]{6}$/i.test(e.target.value)) {
      colorPicker.value = e.target.value;
      updatePreview();
    }
  });
  tagNameInput?.addEventListener("input", updatePreview);

  function updatePreview() {
    const color = colorPicker.value;
    const name = tagNameInput.value.trim() || "Exemple de tag";
    colorHex.value = color;
    tagPreview.style.backgroundColor = color;
    tagPreview.textContent = name;
  }

  // Functions
  async function loadTags() {
    try {
      tags = await pb.collection("tags").getFullList({
        sort: "name"
      });
      renderTags();
    } catch (error) {
      console.error("Erreur:", error);
      alert("Erreur lors du chargement des tags");
    }
  }

  function renderTags() {
    const grid = document.getElementById("tags-grid");
    if (!grid) return;

    if (tags.length === 0) {
      grid.innerHTML = `
        <div class="col-span-full text-center py-12">
          <div class="text-6xl mb-4">🏷️</div>
          <h3 class="text-xl font-medium text-gray-600 mb-2">Aucun tag</h3>
          <p class="text-gray-500">Commencez par créer votre premier tag</p>
        </div>
      `;
      return;
    }

    grid.innerHTML = tags
      .map(
        (tag) => `
        <div class="bg-white border-2 border-black hover:border-4 transition-all group">
          <!-- Tag Visual -->
          <div class="p-6 text-center">
            <div class="mb-4">
              <span 
                class="inline-block px-4 py-2 text-white font-medium uppercase tracking-wide text-lg"
                style="background-color: ${tag.color || '#000000'};"
              >
                ${tag.name}
              </span>
            </div>
            
            ${tag.description ? `<p class="text-sm text-gray-600 mb-4">${tag.description}</p>` : ''}
            
            <!-- Usage count -->
            <div class="text-xs text-gray-500 mb-4">
              <span id="usage-${tag.id}">Calcul en cours...</span>
            </div>
            
            <!-- Actions -->
            <div class="flex gap-2">
              <button 
                onclick="editTag('${tag.id}')"
                class="flex-1 px-3 py-2 text-xs border-2 border-black text-black hover:bg-black hover:text-white transition-all uppercase font-medium"
              >
                ✏️ Modifier
              </button>
              <button 
                onclick="deleteTag('${tag.id}')"
                class="px-3 py-2 text-xs border-2 border-red-600 text-red-600 hover:bg-red-600 hover:text-white transition-all uppercase font-medium"
              >
                🗑️
              </button>
            </div>
          </div>
        </div>
      `
      )
      .join("");

    // Charger le nombre d'utilisations pour chaque tag
    tags.forEach(async (tag) => {
      try {
        const projects = await pb.collection("projets").getFullList({
          filter: `tags ~ "${tag.id}"`
        });
        const usageElement = document.getElementById(`usage-${tag.id}`);
        if (usageElement) {
          usageElement.textContent = `Utilisé dans ${projects.length} projet${projects.length > 1 ? 's' : ''}`;
        }
      } catch (error) {
        console.error("Erreur comptage:", error);
      }
    });
  }

  function openModal(tagId = null) {
    const isEdit = !!tagId;
    document.getElementById("modal-title").textContent = isEdit ? "Modifier le tag" : "Nouveau tag";
    
    if (isEdit) {
      const tag = tags.find(t => t.id === tagId);
      if (tag) {
        document.getElementById("tag-id").value = tag.id;
        document.getElementById("tag-name").value = tag.name || "";
        document.getElementById("tag-color").value = tag.color || "#000000";
        document.getElementById("tag-color-hex").value = tag.color || "#000000";
        document.getElementById("tag-description").value = tag.description || "";
        updatePreview();
      }
    } else {
      form.reset();
      document.getElementById("tag-id").value = "";
      document.getElementById("tag-color").value = "#000000";
      document.getElementById("tag-color-hex").value = "#000000";
      updatePreview();
    }
    
    modal?.classList.remove("hidden");
  }

  function closeModal() {
    modal?.classList.add("hidden");
    form?.reset();
  }

  async function handleSubmit(e) {
    e.preventDefault();
    
    const formData = {
      name: document.getElementById("tag-name").value.trim(),
      color: document.getElementById("tag-color").value,
      description: document.getElementById("tag-description").value.trim() || null,
    };

    try {
      const tagId = document.getElementById("tag-id").value;
      
      if (tagId) {
        await pb.collection("tags").update(tagId, formData);
      } else {
        await pb.collection("tags").create(formData);
      }
      
      closeModal();
      await loadTags();
    } catch (error) {
      console.error("Erreur:", error);
      alert("Erreur lors de la sauvegarde");
    }
  }

  // Global functions for buttons
  window.editTag = (id) => openModal(id);

  window.deleteTag = async (id) => {
    const tag = tags.find(t => t.id === id);
    if (confirm(`Supprimer le tag "${tag?.name}" ?`)) {
      try {
        await pb.collection("tags").delete(id);
        await loadTags();
      } catch (error) {
        console.error("Erreur:", error);
        alert("Erreur lors de la suppression");
      }
    }
  };

  // Déconnexion
  document.getElementById("logout-btn")?.addEventListener("click", () => {
    pb.authStore.clear();
    window.location.href = "/admin";
  });
</script>
</LayoutAdmin>
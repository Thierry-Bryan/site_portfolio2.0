---
import LayoutAdmin from '../../layouts/LayoutAdmin.astro';
import { pb } from '../../utils/pb';

let message = '';
let messageType = 'success';
let themes = [];

try {
  themes = await pb.collection('themes').getFullList({ sort: 'nom' });
} catch (error) {
  message = `Erreur: ${error.message}`;
  messageType = 'error';
}

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action');
    
    if (action === 'update') {
      const id = formData.get('id');
      const data = {
        primary: formData.get('primary'),
        secondary: formData.get('secondary'),
        accent: formData.get('accent'),
        neutral: formData.get('neutral'),
        base_100: formData.get('base_100'),
        info: formData.get('info'),
        success: formData.get('success'),
        warning: formData.get('warning'),
        error: formData.get('error')
      };
      
      await pb.collection('themes').update(id, data);
      message = 'Thème modifié avec succès!';
      return Astro.redirect('/admin/themes-simple');
    }
    
  } catch (error) {
    message = `Erreur: ${error.message}`;
    messageType = 'error';
  }
}
---

<LayoutAdmin title="Thèmes">
  <div class="p-6">
    <h1 class="text-2xl font-bold mb-6">Gestion des Thèmes</h1>

    {message && (
      <div class={`alert ${messageType === 'error' ? 'alert-error' : 'alert-success'} mb-4`}>
        <span>{message}</span>
      </div>
    )}

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Colonne gauche - Liste des thèmes -->
      <div class="space-y-4">
        {themes.map((theme) => (
          <div class="card bg-base-100 border">
            <div class="card-body p-4">
              <h3 class="card-title text-lg mb-3">{theme.nom}</h3>
              
              <form method="POST" class="space-y-3" id={`form-${theme.id}`}>
                <input type="hidden" name="action" value="update" />
                <input type="hidden" name="id" value={theme.id} />
                
                <div class="grid grid-cols-3 gap-3">
                  <div>
                    <label class="text-xs font-medium block mb-1">Primary</label>
                    <input 
                      type="color" 
                      name="primary" 
                      value={theme.primary} 
                      class="w-full h-10 border rounded cursor-pointer"
                      onchange={`document.getElementById('preview-frame').contentWindow.postMessage({type: 'updateColor', color: 'primary', value: this.value}, '*')`}
                    />
                  </div>
                  <div>
                    <label class="text-xs font-medium block mb-1">Secondary</label>
                    <input 
                      type="color" 
                      name="secondary" 
                      value={theme.secondary} 
                      class="w-full h-10 border rounded cursor-pointer"
                      onchange={`document.getElementById('preview-frame').contentWindow.postMessage({type: 'updateColor', color: 'secondary', value: this.value}, '*')`}
                    />
                  </div>
                  <div>
                    <label class="text-xs font-medium block mb-1">Accent</label>
                    <input 
                      type="color" 
                      name="accent" 
                      value={theme.accent} 
                      class="w-full h-10 border rounded cursor-pointer"
                      onchange={`document.getElementById('preview-frame').contentWindow.postMessage({type: 'updateColor', color: 'accent', value: this.value}, '*')`}
                    />
                  </div>
                </div>
                
                <button type="submit" class="btn btn-primary btn-sm w-full">Sauvegarder {theme.nom}</button>
              </form>
            </div>
          </div>
        ))}
      </div>
      
      <!-- Colonne droite - Aperçu -->
      <div>
        <h2 class="text-xl font-semibold mb-4">Aperçu temps réel</h2>
        <p class="text-sm text-gray-600 mb-4">Modifiez les couleurs pour voir l'effet en direct</p>
        <div class="border rounded-lg overflow-hidden bg-white" style="height: 600px;">
          <iframe 
            id="preview-frame"
            src="/projets" 
            class="w-full h-full" 
            title="Aperçu des projets"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</LayoutAdmin>
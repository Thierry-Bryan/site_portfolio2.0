---
// Page de connexion admin
import LayoutAdmin from "../../layouts/LayoutAdmin.astro";
---

<LayoutAdmin title="Admin - Connexion">
  <section
    class="min-h-screen bg-[#faf9f7] flex items-center justify-center py-20 px-4"
  >
    <div class="max-w-md w-full">
      <div class="bg-white border-4 border-black p-8">
        <div class="text-center mb-8">
          <h1 class="text-4xl font-bold text-black uppercase mb-2">
            Administration
          </h1>
          <p class="text-gray-700">Connectez-vous pour accéder au backoffice</p>
        </div>

        <div
          id="error-message"
          class="hidden mb-4 p-3 bg-red-50 border-2 border-red-600 text-red-600 text-sm"
        >
          <!-- Erreur affichée ici -->
        </div>

        <form id="login-form" class="space-y-4">
          <div>
            <label
              for="email"
              class="block text-sm font-bold text-black mb-2 uppercase"
            >
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 border-2 border-black bg-white text-black focus:outline-none focus:border-4"
              placeholder="admin@example.com"
            />
          </div>

          <div>
            <label
              for="password"
              class="block text-sm font-bold text-black mb-2 uppercase"
            >
              Mot de passe
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              class="w-full px-4 py-3 border-2 border-black bg-white text-black focus:outline-none focus:border-4"
              placeholder="••••••••"
            />
          </div>

          <button
            type="submit"
            class="w-full py-4 bg-black text-white font-bold uppercase hover:bg-white hover:text-black border-4 border-black transition-all"
          >
            Connexion
          </button>
        </form>

        <div class="mt-6 text-center">
          <a href="/" class="text-sm text-gray-700 hover:text-black uppercase">
            Retour au site
          </a>
        </div>
      </div>
    </div>
  </section>
</LayoutAdmin>

<script>
  import PocketBase from "pocketbase";

  // Test de plusieurs URLs PocketBase possibles
  const POSSIBLE_URLS = [
    "https://portfolio.bryan-thierry.fr/",
    "https://portfolio.bryan-thierry.fr/api/",
    "https://portfolio.bryan-thierry.fr/_/",
    "http://portfolio.bryan-thierry.fr/",
  ];

  let pb: PocketBase;
  const form = document.getElementById("login-form") as HTMLFormElement;
  const errorDiv = document.getElementById("error-message") as HTMLDivElement;

  console.log("📝 Page de connexion chargée");

  // Fonction pour tester si une URL PocketBase répond
  async function testPocketBaseURL(url: string): Promise<boolean> {
    try {
      console.log(`🔍 Test de l'URL: ${url}`);
      const testPb = new PocketBase(url);
      // Tenter une requête simple pour vérifier la disponibilité
      await fetch(`${url}api/health`, { method: "GET" });
      console.log(`✅ URL accessible: ${url}`);
      return true;
    } catch (e) {
      console.log(`❌ URL non accessible: ${url}`);
      return false;
    }
  }

  // Initialiser PocketBase avec la bonne URL
  (async () => {
    // Essayer chaque URL
    for (const url of POSSIBLE_URLS) {
      try {
        const testPb = new PocketBase(url);
        // Tester avec une simple requête
        const response = await fetch(url, { method: "HEAD" });
        if (response.ok || response.status === 404) {
          console.log(`✅ URL PocketBase trouvée: ${url}`);
          pb = testPb;
          break;
        }
      } catch (e) {
        console.log(`❌ Échec pour: ${url}`);
      }
    }

    if (!pb) {
      console.warn(
        "⚠️ Aucune URL PocketBase valide trouvée, utilisation par défaut",
      );
      pb = new PocketBase(POSSIBLE_URLS[0]);
    }

    console.log("🌐 URL PocketBase finale:", pb.baseURL);
  })();

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!pb) {
      errorDiv.textContent = "❌ Erreur : PocketBase non initialisé";
      errorDiv.classList.remove("hidden");
      return;
    }

    const formData = new FormData(form);
    const email = formData.get("email") as string;
    const password = formData.get("password") as string;

    console.log("🔐 Tentative de connexion pour:", email);
    console.log("🌐 URL PocketBase utilisée:", pb.baseURL);

    try {
      // Tentative 1 : Connexion ADMIN (pour gérer les collections admin-only)
      let authData;
      try {
        console.log("Essai 1: Connexion en tant qu'ADMIN...");
        authData = await pb.admins.authWithPassword(email, password);
        console.log("✅ Connecté en tant qu'ADMIN:", authData.admin.email);
      } catch (adminError) {
        console.warn("⚠️ Échec connexion admin:", adminError);
        console.warn("Essai en tant qu'utilisateur...");
        // Tentative 2 : Connexion USER (si ce n'est pas un compte admin)
        authData = await pb
          .collection("users")
          .authWithPassword(email, password);
        console.log(
          "✅ Connecté en tant qu'UTILISATEUR:",
          authData.record.email,
        );
      }

      console.log("Token reçu:", pb.authStore.token?.substring(0, 20) + "...");

      // SAUVEGARDE MULTIPLE pour garantir la persistance
      // 1. Cookie pour SSR (lecture serveur)
      const cookieStr = pb.authStore.exportToCookie({ httpOnly: false });
      document.cookie = cookieStr;
      console.log("🍪 Cookie sauvegardé:", cookieStr.substring(0, 50) + "...");

      // 2. LocalStorage pour le client (backup)
      localStorage.setItem(
        "pocketbase_auth",
        JSON.stringify({
          token: pb.authStore.token,
          model: pb.authStore.model,
        }),
      );
      console.log("💾 LocalStorage sauvegardé");

      // Attendre un peu pour que les cookies soient bien enregistrés
      await new Promise((resolve) => setTimeout(resolve, 100));

      console.log("🚀 Redirection vers /admin/dashboard");
      // Redirection vers le dashboard
      window.location.href = "/admin/dashboard";
    } catch (error: any) {
      console.error("❌ Erreur de connexion complète:", error);
      console.error("Code erreur:", error.status);
      console.error("Message:", error.message);
      console.error("Détails:", error.data);

      let errorMessage = "Email ou mot de passe incorrect";

      if (error.status === 0 || error.message?.includes("fetch")) {
        errorMessage =
          "❌ Impossible de contacter le serveur PocketBase. Vérifiez que https://portfolio.bryan-thierry.fr/ est accessible.";
      } else if (error.status === 400) {
        errorMessage =
          "Email ou mot de passe incorrect. Vérifiez vos identifiants PocketBase.";
      } else if (error.status === 404) {
        errorMessage =
          "❌ Collection 'users' ou endpoint admin introuvable. Problème de configuration PocketBase.";
      }

      errorDiv.textContent = errorMessage;
      errorDiv.classList.remove("hidden");
    }
  });
</script>

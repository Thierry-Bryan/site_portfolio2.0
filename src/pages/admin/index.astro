---
// Page de connexion admin
import Layout from "../../layouts/Layout.astro";

// Redirection côté client si déjà connecté
---

<Layout title="Admin - Connexion" theme="basique">
  <section class="min-h-screen bg-[var(--b1)] flex items-center justify-center py-20 px-4">
    <div class="max-w-md w-full">
      <div class="border-4 border-[var(--bc)] bg-[var(--b1)] p-8">
        <h1 class="text-4xl font-primary text-[var(--bc)] mb-8 text-center">
          ADMIN LOGIN
        </h1>

        <div id="error-message" class="hidden mb-4 p-4 bg-red-100 border-2 border-red-500 text-red-700">
          <!-- Erreur affichée ici -->
        </div>

        <form id="login-form" class="space-y-6">
          <div>
            <label for="email" class="block text-[var(--bc)] font-secondary mb-2">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full p-3 border-2 border-[var(--bc)] bg-[var(--b1)] text-[var(--bc)] font-secondary focus:outline-none focus:border-[var(--p)]"
              placeholder="admin@example.com"
            />
          </div>

          <div>
            <label for="password" class="block text-[var(--bc)] font-secondary mb-2">
              Mot de passe
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              class="w-full p-3 border-2 border-[var(--bc)] bg-[var(--b1)] text-[var(--bc)] font-secondary focus:outline-none focus:border-[var(--p)]"
              placeholder="••••••••"
            />
          </div>

          <button
            type="submit"
            class="w-full p-4 bg-[var(--p)] text-[var(--b1)] font-primary text-xl border-2 border-[var(--bc)] hover:shadow-[4px_4px_0px_var(--bc)] transition-all duration-200"
          >
            SE CONNECTER
          </button>
        </form>

        <div class="mt-6 text-center">
          <a href="/" class="text-[var(--bc)] font-secondary hover:text-[var(--p)] transition-colors">
            ← Retour au site
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import PocketBase from "pocketbase";
  
  const pb = new PocketBase("https://portfolio.bryan-thierry.fr/");
  const form = document.getElementById("login-form") as HTMLFormElement;
  const errorDiv = document.getElementById("error-message") as HTMLDivElement;

  // Vérifier si déjà connecté
  if (pb.authStore.isValid) {
    window.location.href = "/admin/dashboard";
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const email = formData.get("email") as string;
    const password = formData.get("password") as string;

    try {
      // Connexion admin
      await pb.admins.authWithPassword(email, password);
      
      // Redirection vers le dashboard
      window.location.href = "/admin/dashboard";
    } catch (error: any) {
      console.error("Erreur de connexion:", error);
      errorDiv.textContent = "Email ou mot de passe incorrect";
      errorDiv.classList.remove("hidden");
    }
  });
</script>
</Layout>

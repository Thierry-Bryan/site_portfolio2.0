---
// Gestion complète des projets avec upload d'images
import LayoutAdmin from "../../layouts/LayoutAdmin.astro";
---

<LayoutAdmin title="Admin - Projets">
  <div id="admin-content" class="hidden">
    <!-- Sidebar -->
    <aside
      class="fixed left-0 top-0 h-screen w-64 bg-black text-white flex flex-col z-50"
    >
      <div class="p-6 border-b-2 border-white">
        <h1 class="text-xl font-bold uppercase">Portfolio Admin</h1>
      </div>

      <nav class="flex-1 p-4 space-y-1">
        <a
          href="/admin/dashboard"
          class="block px-4 py-2 hover:bg-white hover:text-black transition-colors uppercase text-sm"
        >
          Dashboard
        </a>
        <a
          href="/admin/projets"
          class="block px-4 py-2 bg-white text-black uppercase text-sm font-bold"
        >
          Projets
        </a>
        <a
          href="/admin/themes"
          class="block px-4 py-2 hover:bg-white hover:text-black transition-colors uppercase text-sm"
        >
          Thèmes
        </a>
        <a
          href="/admin/tags"
          class="block px-4 py-2 hover:bg-white hover:text-black transition-colors uppercase text-sm"
        >
          Tags
        </a>
        <a
          href="/admin/technologies"
          class="block px-4 py-2 hover:bg-white hover:text-black transition-colors uppercase text-sm"
        >
          Technologies
        </a>
      </nav>

      <div class="p-4 border-t-2 border-white">
        <button
          id="logout-btn"
          class="w-full px-4 py-2 bg-red-600 hover:bg-red-700 text-white transition-colors uppercase text-sm font-bold"
        >
          Déconnexion
        </button>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="ml-64 min-h-screen bg-[#faf9f7]">
      <div class="p-8">
        <div class="flex justify-between items-center mb-8">
          <div>
            <h2 class="text-4xl font-black text-black uppercase mb-2 tracking-wider">
              Mes Projets
            </h2>
            <p class="text-gray-600 text-lg">Créez et gérez vos réalisations avec images et détails</p>
          </div>
          <button
            id="new-project-btn"
            class="px-6 py-3 bg-black text-white font-medium uppercase border-2 border-black hover:bg-white hover:text-black transition-all"
          >
            📱 Nouveau projet
          </button>
        </div>

        <!-- Liste des projets -->
        <div
          id="projects-list"
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
        >
          <!-- Projets chargés dynamiquement -->
        </div>

        <!-- Modal création/édition -->
        <div
          id="project-modal"
          class="hidden fixed inset-0 bg-black/80 flex items-center justify-center z-50 p-4 overflow-y-auto"
        >
          <div class="bg-[#faf9f7] border-4 border-black max-w-5xl w-full my-8">
            <!-- Header Modal -->
            <div
              class="flex justify-between items-center p-6 border-b-4 border-black bg-white"
            >
              <h2
                class="text-3xl font-bold text-black uppercase"
                id="modal-title"
              >
                Nouveau projet
              </h2>
              <button
                id="close-modal"
                class="text-black text-4xl leading-none hover:text-gray-600"
                >×</button
              >
            </div>

            <!-- Form Content -->
            <div class="p-6 max-h-[70vh] overflow-y-auto">
              <form id="project-form" class="space-y-6">
                <input type="hidden" id="project-id" />

                <!-- Titre -->
                <div>
                  <label
                    class="block text-sm font-bold text-black mb-2 uppercase"
                  >
                    Titre du projet <span class="text-red-600">*</span>
                  </label>
                  <input
                    type="text"
                    id="project-title"
                    required
                    placeholder="Mon Super Projet"
                    class="w-full px-4 py-3 border-2 border-black bg-white text-black focus:outline-none focus:border-4"
                  />
                </div>

                <!-- Slug -->
                <div>
                  <label
                    class="block text-sm font-bold text-black mb-2 uppercase"
                  >
                    Slug (URL) <span class="text-red-600">*</span>
                  </label>
                  <input
                    type="text"
                    id="project-slug"
                    required
                    placeholder="mon-super-projet"
                    class="w-full px-4 py-3 border-2 border-black bg-white text-black focus:outline-none focus:border-4"
                  />
                  <p class="text-xs text-gray-600 mt-1">
                    URL : /projets/mon-super-projet
                  </p>
                </div>

                <!-- Sous-titre -->
                <div>
                  <label
                    class="block text-sm font-bold text-black mb-2 uppercase"
                  >
                    Sous-titre
                  </label>
                  <input
                    type="text"
                    id="project-subtitle"
                    placeholder="Description courte"
                    class="w-full px-4 py-3 border-2 border-black bg-white text-black focus:outline-none focus:border-4"
                  />
                </div>

                <!-- Description complète -->
                <div>
                  <label
                    class="block text-sm font-bold text-black mb-2 uppercase"
                  >
                    Description complète
                  </label>
                  <textarea
                    id="project-description"
                    rows="6"
                    placeholder="Description détaillée du projet..."
                    class="w-full px-4 py-3 border-2 border-black bg-white text-black focus:outline-none focus:border-4"
                  ></textarea>
                </div>

                <!-- Image Hero -->
                <div>
                  <label
                    class="block text-sm font-bold text-black mb-2 uppercase"
                  >
                    Image Hero <span class="text-red-600">*</span>
                  </label>
                  <input
                    type="file"
                    id="project-hero-image"
                    accept="image/*"
                    class="w-full px-4 py-3 border-2 border-black bg-white text-black"
                  />
                  <div id="hero-preview" class="mt-3"></div>
                </div>

                <!-- Galerie d'images -->
                <div>
                  <label
                    class="block text-sm font-bold text-black mb-2 uppercase"
                  >
                    Galerie d'images
                  </label>
                  <input
                    type="file"
                    id="project-gallery"
                    accept="image/*"
                    multiple
                    class="w-full px-4 py-3 border-2 border-black bg-white text-black"
                  />
                  <div id="gallery-preview" class="mt-3 grid grid-cols-3 gap-2">
                  </div>
                </div>

                <!-- Thème -->
                <div>
                  <label
                    class="block text-sm font-bold text-black mb-2 uppercase"
                  >
                    Thème <span class="text-red-600">*</span>
                  </label>
                  <select
                    id="project-theme"
                    required
                    class="w-full px-4 py-3 border-2 border-black bg-white text-black focus:outline-none focus:border-4"
                  >
                    <option value="">Chargement...</option>
                  </select>
                </div>

                <!-- Tags -->
                <div>
                  <label
                    class="block text-sm font-bold text-black mb-2 uppercase"
                  >
                    Tags
                  </label>
                  <div
                    id="tags-checkboxes"
                    class="space-y-2 p-4 border-2 border-black bg-white"
                  >
                    <!-- Tags chargés dynamiquement -->
                  </div>
                </div>

                <!-- Technologies -->
                <div>
                  <label
                    class="block text-sm font-bold text-black mb-2 uppercase"
                  >
                    Technologies
                  </label>
                  <div
                    id="techs-checkboxes"
                    class="space-y-2 p-4 border-2 border-black bg-white"
                  >
                    <!-- Technologies chargées dynamiquement -->
                  </div>
                </div>

                <!-- Ordre -->
                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <label
                      class="block text-sm font-bold text-black mb-2 uppercase"
                    >
                      Ordre d'affichage
                    </label>
                    <input
                      type="number"
                      id="project-order"
                      value="0"
                      class="w-full px-4 py-3 border-2 border-black bg-white text-black focus:outline-none focus:border-4"
                    />
                  </div>
                  <div>
                    <label
                      class="block text-sm font-bold text-black mb-2 uppercase"
                    >
                      Publié
                    </label>
                    <label
                      class="flex items-center gap-3 px-4 py-3 border-2 border-black bg-white cursor-pointer"
                    >
                      <input
                        type="checkbox"
                        id="project-published"
                        class="w-5 h-5"
                      />
                      <span class="text-black">Visible sur le site</span>
                    </label>
                  </div>
                </div>
              </form>
            </div>

            <!-- Footer Modal -->
            <div
              class="p-6 border-t-4 border-black bg-white flex justify-end gap-3"
            >
              <button
                type="button"
                id="cancel-btn"
                class="px-6 py-3 border-2 border-black bg-white text-black uppercase font-bold hover:bg-black hover:text-white transition-all"
              >
                Annuler
              </button>
              <button
                type="submit"
                form="project-form"
                class="px-6 py-3 bg-black text-white uppercase font-bold border-2 border-black hover:bg-white hover:text-black transition-all"
              >
                Enregistrer
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <div id="loading" class="min-h-screen flex items-center justify-center">
    <div class="text-2xl font-bold uppercase">Chargement...</div>
  </div>
</LayoutAdmin>

<script>
  import PocketBase from "pocketbase";

  const pb = new PocketBase("https://portfolio.bryan-thierry.fr/");

  if (!pb.authStore.isValid) {
    window.location.href = "/admin";
  } else {
    document.getElementById("loading")?.classList.add("hidden");
    document.getElementById("admin-content")?.classList.remove("hidden");
    loadProjects();
    loadThemes();
    loadTags();
    loadTechs();
  }

  let allThemes: any[] = [];
  let allTags: any[] = [];
  let allTechs: any[] = [];

  // Charger les thèmes
  async function loadThemes() {
    try {
      allThemes = await pb.collection("themes").getFullList({ sort: "name" });
      const select = document.getElementById(
        "project-theme",
      ) as HTMLSelectElement;
      select.innerHTML =
        '<option value="">Sélectionner un thème</option>' +
        allThemes
          .map((t) => `<option value="${t.id}">${t.name}</option>`)
          .join("");
    } catch (error) {
      console.error("Erreur chargement thèmes:", error);
    }
  }

  // Charger les tags
  async function loadTags() {
    try {
      allTags = await pb.collection("tags").getFullList({ sort: "name" });
      const container = document.getElementById("tags-checkboxes")!;
      container.innerHTML = allTags
        .map(
          (tag) => `
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" value="${tag.id}" class="tag-checkbox w-4 h-4" />
          <span>${tag.name}</span>
        </label>
      `,
        )
        .join("");
    } catch (error) {
      console.error("Erreur chargement tags:", error);
    }
  }

  // Charger les technologies
  async function loadTechs() {
    try {
      allTechs = await pb
        .collection("technologies")
        .getFullList({ sort: "name" });
      const container = document.getElementById("techs-checkboxes")!;
      container.innerHTML = allTechs
        .map(
          (tech) => `
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" value="${tech.id}" class="tech-checkbox w-4 h-4" />
          <span>${tech.name}</span>
        </label>
      `,
        )
        .join("");
    } catch (error) {
      console.error("Erreur chargement techs:", error);
    }
  }

  // Charger les projets
  async function loadProjects() {
    try {
      const projects = await pb.collection("projets").getFullList({
        sort: "-created",
        expand: "theme,tags,technologies",
      });
      const container = document.getElementById("projects-list")!;

      if (projects.length === 0) {
        container.innerHTML = `
          <div class="col-span-full text-center py-12">
            <div class="text-6xl mb-4">📱</div>
            <h3 class="text-xl font-medium text-gray-600 mb-2">Aucun projet</h3>
            <p class="text-gray-500 mb-4">Commencez par créer votre premier projet</p>
            <button onclick="document.getElementById('new-project-btn').click()" 
                    class="px-6 py-3 bg-black text-white font-medium uppercase hover:bg-gray-800 transition-colors">
              ✨ Créer mon premier projet
            </button>
          </div>
        `;
        return;
      }

      container.innerHTML = projects
        .map((project) => {
          const imageUrl = project.hero_image
            ? pb.files.getUrl(project, project.hero_image, { thumb: "300x200" })
            : null;
          const themeName = project.expand?.theme?.name || "basique";
          const galleryCount = project.gallery ? project.gallery.length : 0;

          return `
          <div class="bg-white border-2 border-black hover:border-4 hover:shadow-lg transition-all group">
            <!-- Image Header -->
            <div class="aspect-video bg-gray-100 overflow-hidden relative">
              ${imageUrl 
                ? `<img src="${imageUrl}" alt="${project.title}" class="w-full h-full object-cover" />`
                : `<div class="w-full h-full flex items-center justify-center text-gray-400">
                     <div class="text-center">
                       <div class="text-4xl mb-2">📷</div>
                       <div class="text-sm">Aucune image</div>
                     </div>
                   </div>`
              }
              ${project.published 
                ? `<span class="absolute top-2 right-2 bg-green-600 text-white text-xs px-2 py-1 font-medium">PUBLIÉ</span>`
                : `<span class="absolute top-2 right-2 bg-orange-600 text-white text-xs px-2 py-1 font-medium">BROUILLON</span>`
              }
              ${galleryCount > 0 
                ? `<span class="absolute bottom-2 right-2 bg-black/70 text-white text-xs px-2 py-1">📷 ${galleryCount}</span>`
                : ''
              }
            </div>
            
            <!-- Content -->
            <div class="p-6">
              <div class="mb-4">
                <h3 class="text-xl font-medium text-black mb-1 group-hover:font-semibold transition-all">${project.title}</h3>
                ${project.subtitle ? `<p class="text-sm text-gray-600">${project.subtitle}</p>` : ''}
              </div>
              
              <!-- Meta info -->
              <div class="flex items-center justify-between text-xs text-gray-500 mb-4">
                <span class="px-2 py-1 bg-black text-white uppercase tracking-wide">🎨 ${themeName}</span>
                <span>/projets/${project.slug}</span>
              </div>
              
              <!-- Tags preview -->
              ${project.expand?.tags ? `
                <div class="mb-4">
                  <div class="flex flex-wrap gap-1">
                    ${project.expand.tags.slice(0, 3).map(tag => `
                      <span class="text-xs px-2 py-1 text-white" style="background-color: ${tag.color || '#000'}">${tag.name}</span>
                    `).join('')}
                    ${project.expand.tags.length > 3 ? `<span class="text-xs text-gray-400">+${project.expand.tags.length - 3}</span>` : ''}
                  </div>
                </div>
              ` : ''}
              
              <!-- Actions -->
              <div class="flex gap-2">
                <button onclick="editProject('${project.id}')" 
                        class="flex-1 px-4 py-2 bg-black text-white text-sm uppercase font-medium hover:bg-gray-800 transition-all">
                  ✏️ Modifier
                </button>
                <button onclick="duplicateProject('${project.id}')" 
                        class="px-4 py-2 border-2 border-black text-black text-sm uppercase font-medium hover:bg-black hover:text-white transition-all">
                  📄
                </button>
                <button onclick="deleteProject('${project.id}', '${project.title}')" 
                        class="px-4 py-2 bg-red-600 text-white text-sm uppercase font-medium hover:bg-red-700 transition-all">
                  🗑️
                </button>
              </div>
            </div>
          </div>
        `;
        })
        .join("");
    } catch (error) {
      console.error("Erreur chargement projets:", error);
    }
  }

  // Nouveau projet
  document.getElementById("new-project-btn")?.addEventListener("click", () => {
    (document.getElementById("project-form") as HTMLFormElement).reset();
    (document.getElementById("project-id") as HTMLInputElement).value = "";
    document.getElementById("modal-title")!.textContent = "Nouveau projet";
    document.getElementById("project-modal")?.classList.remove("hidden");

    // Décocher tous les checkboxes
    document
      .querySelectorAll(".tag-checkbox")
      .forEach((cb: any) => (cb.checked = false));
    document
      .querySelectorAll(".tech-checkbox")
      .forEach((cb: any) => (cb.checked = false));
  });

  // Auto-generate slug
  document.getElementById("project-title")?.addEventListener("input", (e) => {
    const title = (e.target as HTMLInputElement).value;
    const slug = title
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
    (document.getElementById("project-slug") as HTMLInputElement).value = slug;
  });

  // Fermer modal
  document.getElementById("close-modal")?.addEventListener("click", closeModal);
  document.getElementById("cancel-btn")?.addEventListener("click", closeModal);

  function closeModal() {
    document.getElementById("project-modal")?.classList.add("hidden");
  }

  // Sauvegarder
  document
    .getElementById("project-form")
    ?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const projectId = (
        document.getElementById("project-id") as HTMLInputElement
      ).value;
      const formData = new FormData();

      formData.append(
        "title",
        (document.getElementById("project-title") as HTMLInputElement).value,
      );
      formData.append(
        "slug",
        (document.getElementById("project-slug") as HTMLInputElement).value,
      );
      formData.append(
        "subtitle",
        (document.getElementById("project-subtitle") as HTMLInputElement).value,
      );
      formData.append(
        "description",
        (document.getElementById("project-description") as HTMLTextAreaElement)
          .value,
      );
      formData.append(
        "theme",
        (document.getElementById("project-theme") as HTMLSelectElement).value,
      );
      formData.append(
        "order",
        (document.getElementById("project-order") as HTMLInputElement).value,
      );
      formData.append(
        "published",
        (
          document.getElementById("project-published") as HTMLInputElement
        ).checked.toString(),
      );

      // Tags sélectionnés
      const selectedTags = Array.from(
        document.querySelectorAll(".tag-checkbox:checked"),
      ).map((cb: any) => cb.value);
      selectedTags.forEach((tagId) => formData.append("tags", tagId));

      // Technologies sélectionnées
      const selectedTechs = Array.from(
        document.querySelectorAll(".tech-checkbox:checked"),
      ).map((cb: any) => cb.value);
      selectedTechs.forEach((techId) =>
        formData.append("technologies", techId),
      );

      // Image hero
      const heroImageInput = document.getElementById(
        "project-hero-image",
      ) as HTMLInputElement;
      if (heroImageInput.files && heroImageInput.files[0]) {
        formData.append("hero_image", heroImageInput.files[0]);
      }

      // Galerie (si supporté par le schema)
      const galleryInput = document.getElementById(
        "project-gallery",
      ) as HTMLInputElement;
      if (galleryInput.files) {
        Array.from(galleryInput.files).forEach((file) => {
          formData.append("gallery", file);
        });
      }

      try {
        if (projectId) {
          await pb.collection("projets").update(projectId, formData);
        } else {
          await pb.collection("projets").create(formData);
        }

        closeModal();
        loadProjects();
        alert("Projet enregistré avec succès !");
      } catch (error: any) {
        console.error("Erreur sauvegarde:", error);
        alert("Erreur: " + (error.message || "Impossible d'enregistrer"));
      }
    });

  // Éditer un projet
  (window as any).editProject = async (id: string) => {
    try {
      const project = await pb
        .collection("projets")
        .getOne(id, { expand: "tags,technologies,theme" });

      // Remplir les champs basiques
      (document.getElementById("project-id") as HTMLInputElement).value = id;
      (document.getElementById("project-title") as HTMLInputElement).value =
        project.title;
      (document.getElementById("project-slug") as HTMLInputElement).value =
        project.slug;
      (document.getElementById("project-subtitle") as HTMLInputElement).value =
        project.subtitle || "";
      (
        document.getElementById("project-description") as HTMLTextAreaElement
      ).value = project.description || "";
      (document.getElementById("project-theme") as HTMLSelectElement).value =
        project.theme;
      (document.getElementById("project-order") as HTMLInputElement).value =
        project.order?.toString() || "0";
      (
        document.getElementById("project-published") as HTMLInputElement
      ).checked = project.published;

      // Afficher l'image hero existante
      const heroPreview = document.getElementById("hero-preview");
      if (heroPreview) {
        if (project.hero_image) {
          const imageUrl = pb.files.getUrl(project, project.hero_image);
          heroPreview.innerHTML = `
            <div class="relative">
              <img src="${imageUrl}" class="w-full h-32 object-cover border-2 border-black" />
              <button type="button" onclick="removeCurrentHeroImage()" 
                      class="absolute -top-2 -right-2 bg-red-600 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm hover:bg-red-700">
                ×
              </button>
            </div>
            <p class="text-xs text-gray-600 mt-1">Image actuelle (sera conservée si aucune nouvelle image n'est sélectionnée)</p>
          `;
        } else {
          heroPreview.innerHTML = "";
        }
      }

      // Afficher les images de galerie existantes
      const galleryPreview = document.getElementById("gallery-preview");
      if (galleryPreview && project.gallery?.length > 0) {
        galleryPreview.innerHTML = `
          <div class="grid grid-cols-3 gap-2 mt-3">
            ${project.gallery.map((image: string, index: number) => {
              const imageUrl = pb.files.getUrl(project, image);
              return `
                <div class="relative group">
                  <img src="${imageUrl}" class="w-full h-20 object-cover border border-gray-300" />
                  <button type="button" onclick="removeGalleryImage('${image}', ${index})"
                          class="absolute -top-1 -right-1 bg-red-600 text-white rounded-full w-4 h-4 flex items-center justify-center text-xs opacity-0 group-hover:opacity-100 transition-opacity">
                    ×
                  </button>
                </div>
              `;
            }).join('')}
          </div>
          <p class="text-xs text-gray-600 mt-1">Images actuelles de la galerie</p>
        `;
      } else {
        if (galleryPreview) galleryPreview.innerHTML = "";
      }

      // Stocker les données originales pour comparaison
      (window as any).originalProjectData = {
        hero_image: project.hero_image,
        gallery: project.gallery || []
      };

      // Cocher les tags
      document.querySelectorAll(".tag-checkbox").forEach((cb: any) => {
        cb.checked = project.tags?.includes(cb.value);
      });

      // Cocher les technologies
      document.querySelectorAll(".tech-checkbox").forEach((cb: any) => {
        cb.checked = project.technologies?.includes(cb.value);
      });

      document.getElementById("modal-title")!.textContent =
        `Modifier : ${project.title}`;
      document.getElementById("project-modal")?.classList.remove("hidden");
    } catch (error) {
      console.error("Erreur:", error);
      alert("Erreur lors du chargement du projet");
    }
  };

  // Supprimer un projet
  (window as any).deleteProject = async (id: string, title: string) => {
    if (!confirm(`Êtes-vous sûr de vouloir supprimer "${title}" ?`)) return;

    try {
      await pb.collection("projets").delete(id);
      loadProjects();
      alert("Projet supprimé !");
    } catch (error) {
      console.error("Erreur:", error);
      alert("Erreur lors de la suppression");
    }
  };

  // Dupliquer un projet
  (window as any).duplicateProject = async (id: string) => {
    try {
      const project = await pb.collection("projets").getOne(id);
      
      const duplicatedData = {
        title: `${project.title} (Copie)`,
        slug: `${project.slug}-copie-${Date.now()}`,
        subtitle: project.subtitle,
        description: project.description,
        theme: project.theme,
        tags: project.tags,
        technologies: project.technologies,
        published: false,
        order: project.order,
      };
      
      await pb.collection("projets").create(duplicatedData);
      loadProjects();
      alert("Projet dupliqué avec succès !");
    } catch (error) {
      console.error("Erreur:", error);
      alert("Erreur lors de la duplication");
    }
  };

  // Fonctions pour gérer les images existantes
  (window as any).removeCurrentHeroImage = () => {
    if (confirm("Supprimer l'image hero actuelle ?")) {
      (window as any).removeHeroImageFlag = true;
      document.getElementById("hero-preview")!.innerHTML = `
        <p class="text-red-600 text-sm font-medium">⚠️ L'image hero sera supprimée lors de la sauvegarde</p>
      `;
    }
  };

  (window as any).removeGalleryImage = (imageName: string, index: number) => {
    if (confirm("Supprimer cette image de la galerie ?")) {
      if (!(window as any).removeGalleryImages) {
        (window as any).removeGalleryImages = [];
      }
      (window as any).removeGalleryImages.push(imageName);
      
      // Mettre à jour l'affichage
      const galleryPreview = document.getElementById("gallery-preview");
      if (galleryPreview && (window as any).originalProjectData?.gallery) {
        const remainingImages = (window as any).originalProjectData.gallery.filter(
          (img: string) => !(window as any).removeGalleryImages.includes(img)
        );
        
        if (remainingImages.length === 0) {
          galleryPreview.innerHTML = `<p class="text-red-600 text-sm font-medium">⚠️ Toutes les images de galerie seront supprimées</p>`;
        } else {
          galleryPreview.innerHTML = `
            <div class="grid grid-cols-3 gap-2 mt-3">
              ${remainingImages.map((image: string) => {
                const imageUrl = pb.files.getUrl((window as any).originalProjectData, image);
                return `<img src="${imageUrl}" class="w-full h-20 object-cover border border-gray-300" />`;
              }).join('')}
            </div>
            <p class="text-xs text-red-600 mt-1">⚠️ Certaines images seront supprimées lors de la sauvegarde</p>
          `;
        }
      }
    }
  };

  // Déconnexion
  document.getElementById("logout-btn")?.addEventListener("click", () => {
    pb.authStore.clear();
    window.location.href = "/admin";
  });
</script>

---
import LayoutAdmin from "../../layouts/LayoutAdmin.astro";
---

<LayoutAdmin title="Admin - Projets">
  <div id="admin-content" class="hidden">
    <!-- Sidebar -->
    <aside class="fixed left-0 top-0 h-screen w-64 bg-[var(--n)] text-[var(--nc)] flex flex-col z-50">
      <div class="p-6 border-b border-[var(--nc)]/20">
        <h1 class="text-xl font-medium uppercase tracking-wider">Portfolio Admin</h1>
      </div>
      <nav class="flex-1 p-4 space-y-1">
        <a href="/admin/dashboard" class="block px-4 py-2 hover:bg-[var(--nc)] hover:text-[var(--n)] transition-colors uppercase text-sm">Dashboard</a>
        <a href="/admin/projets" class="block px-4 py-2 bg-[var(--nc)] text-[var(--n)] uppercase text-sm font-medium">Projets</a>
        <a href="/admin/themes" class="block px-4 py-2 hover:bg-[var(--nc)] hover:text-[var(--n)] transition-colors uppercase text-sm">Thèmes</a>
        <a href="/admin/tags" class="block px-4 py-2 hover:bg-[var(--nc)] hover:text-[var(--n)] transition-colors uppercase text-sm">Tags</a>
        <a href="/admin/technologies" class="block px-4 py-2 hover:bg-[var(--nc)] hover:text-[var(--n)] transition-colors uppercase text-sm">Technologies</a>
      </nav>
      <div class="p-4 border-t border-[var(--nc)]/20">
        <button id="logout-btn" class="w-full px-4 py-2 bg-error text-error-content transition-colors uppercase text-sm">Déconnexion</button>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="ml-64 min-h-screen bg-[var(--b1)]">
      <div class="p-8">
        <!-- Header -->
        <div class="flex justify-between items-center mb-8">
          <div>
            <h1 class="text-4xl font-bold text-[var(--bc)] uppercase tracking-wider mb-2">Mes Projets</h1>
            <p class="text-[var(--bc)]/70 text-lg">Gérez vos réalisations</p>
          </div>
          <button id="new-project-btn" class="btn btn-primary uppercase">Nouveau Projet</button>
        </div>

        <!-- Stats rapides -->
        <div class="grid grid-cols-3 gap-6 mb-8">
          <div class="bg-[var(--b2)] border-4 border-[var(--bc)] p-6">
            <div class="text-3xl font-bold text-[var(--bc)] mb-1" id="stat-total">-</div>
            <div class="text-sm text-[var(--bc)]/70 uppercase">Total</div>
          </div>
          <div class="bg-[var(--b2)] border-4 border-[var(--bc)] p-6">
            <div class="text-3xl font-bold text-success mb-1" id="stat-published">-</div>
            <div class="text-sm text-[var(--bc)]/70 uppercase">Publiés</div>
          </div>
          <div class="bg-[var(--b2)] border-4 border-[var(--bc)] p-6">
            <div class="text-3xl font-bold text-warning mb-1" id="stat-drafts">-</div>
            <div class="text-sm text-[var(--bc)]/70 uppercase">Brouillons</div>
          </div>
        </div>

        <!-- Liste des projets -->
        <div id="projects-list" class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6">
          <!-- Projets chargés dynamiquement -->
        </div>
      </div>
    </main>

    <!-- Modal Édition - Layout 2 colonnes -->
    <div id="project-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
      <div class="bg-[var(--b1)] border-4 border-[var(--bc)] max-w-7xl w-full h-[90vh] flex">
        <!-- Colonne gauche - Formulaire -->
        <div class="w-1/2 p-6 overflow-y-auto border-r-4 border-[var(--bc)]">
          <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-bold text-[var(--bc)] uppercase" id="modal-title">Nouveau Projet</h2>
            <button id="close-modal" class="text-[var(--bc)] text-3xl hover:text-[var(--bc)]/70">×</button>
          </div>

          <form id="project-form" class="space-y-6">
            <input type="hidden" id="project-id" />

            <!-- Titre -->
            <div>
              <label class="block text-sm font-medium text-[var(--bc)] mb-2 uppercase">Titre *</label>
              <input type="text" id="project-title" required placeholder="Nom du projet"
                class="input input-bordered w-full bg-[var(--b2)] text-[var(--bc)] border-2 border-[var(--bc)]" />
            </div>

            <!-- Slug -->
            <div>
              <label class="block text-sm font-medium text-[var(--bc)] mb-2 uppercase">Slug *</label>
              <input type="text" id="project-slug" required placeholder="url-du-projet"
                class="input input-bordered w-full bg-[var(--b2)] text-[var(--bc)] border-2 border-[var(--bc)]" />
              <div class="text-xs text-[var(--bc)]/70 mt-1">URL : /projets/url-du-projet</div>
            </div>

            <!-- Sous-titre -->
            <div>
              <label class="block text-sm font-medium text-[var(--bc)] mb-2 uppercase">Sous-titre</label>
              <input type="text" id="project-subtitle" placeholder="Description courte"
                class="input input-bordered w-full bg-[var(--b2)] text-[var(--bc)] border-2 border-[var(--bc)]" />
            </div>

            <!-- Description -->
            <div>
              <label class="block text-sm font-medium text-[var(--bc)] mb-2 uppercase">Description</label>
              <textarea id="project-description" rows="4" placeholder="Description détaillée du projet..."
                class="textarea textarea-bordered w-full bg-[var(--b2)] text-[var(--bc)] border-2 border-[var(--bc)]"></textarea>
            </div>

            <!-- Image Hero -->
            <div>
              <label class="block text-sm font-medium text-[var(--bc)] mb-2 uppercase">Image principale</label>
              <input type="file" id="project-hero-image" accept="image/*" 
                class="file-input file-input-bordered w-full bg-[var(--b2)] border-2 border-[var(--bc)]" />
              <div id="hero-preview" class="mt-3"></div>
            </div>

            <!-- Galerie -->
            <div>
              <label class="block text-sm font-medium text-[var(--bc)] mb-2 uppercase">Galerie d'images</label>
              <input type="file" id="project-gallery" multiple accept="image/*"
                class="file-input file-input-bordered w-full bg-[var(--b2)] border-2 border-[var(--bc)]" />
              <div id="gallery-preview" class="mt-3"></div>
            </div>

            <!-- Thème -->
            <div>
              <label class="block text-sm font-medium text-[var(--bc)] mb-2 uppercase">Thème</label>
              <select id="project-theme" class="select select-bordered w-full bg-[var(--b2)] text-[var(--bc)] border-2 border-[var(--bc)]">
                <option>Chargement...</option>
              </select>
            </div>

            <!-- Tags -->
            <div>
              <label class="block text-sm font-medium text-[var(--bc)] mb-2 uppercase">Tags</label>
              <div id="tags-container" class="grid grid-cols-2 gap-2">
                <!-- Tags chargés dynamiquement -->
              </div>
            </div>

            <!-- Technologies -->
            <div>
              <label class="block text-sm font-medium text-[var(--bc)] mb-2 uppercase">Technologies</label>
              <div id="technologies-container" class="grid grid-cols-2 gap-2">
                <!-- Technologies chargées dynamiquement -->
              </div>
            </div>

            <!-- Options -->
            <div class="grid grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-[var(--bc)] mb-2 uppercase">Ordre d'affichage</label>
                <input type="number" id="project-order" value="0" min="0"
                  class="input input-bordered w-full bg-[var(--b2)] text-[var(--bc)] border-2 border-[var(--bc)]" />
              </div>
              <div class="flex items-center pt-8">
                <input type="checkbox" id="project-published" class="checkbox checkbox-primary mr-2" />
                <label for="project-published" class="text-sm font-medium text-[var(--bc)] uppercase">Publié</label>
              </div>
            </div>

            <!-- Boutons -->
            <div class="flex gap-4 pt-6">
              <button type="submit" class="btn btn-primary flex-1 uppercase">Sauvegarder</button>
              <button type="button" id="cancel-btn" class="btn btn-outline uppercase">Annuler</button>
            </div>
          </form>
        </div>

        <!-- Colonne droite - Aperçu -->
        <div class="w-1/2 p-6 bg-[var(--b2)]">
          <h3 class="text-lg font-medium text-[var(--bc)] uppercase mb-4">Aperçu du projet</h3>
          <div id="project-preview" class="border-4 border-[var(--bc)] bg-[var(--b1)] h-full overflow-hidden">
            <!-- Aperçu généré dynamiquement -->
            <div class="p-6 text-center text-[var(--bc)]/50">
              Sélectionnez un thème et ajoutez du contenu pour voir l'aperçu
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Loading -->
  <div id="loading" class="min-h-screen flex items-center justify-center bg-[var(--b1)]">
    <span class="loading loading-spinner loading-lg"></span>
    <span class="ml-4 text-[var(--bc)] text-xl">Chargement...</span>
  </div>
</LayoutAdmin>

<script>
  import PocketBase from "pocketbase";

  const pb = new PocketBase("https://portfolio.bryan-thierry.fr/");

  // Variables globales
  let themes = [];
  let tags = [];
  let technologies = [];
  let projects = [];

  // Vérifier l'authentification
  if (!pb.authStore.isValid) {
    window.location.href = "/admin";
  } else {
    document.getElementById("loading")?.classList.add("hidden");
    document.getElementById("admin-content")?.classList.remove("hidden");
    initializeAdmin();
  }

  async function initializeAdmin() {
    await Promise.all([
      loadThemes(),
      loadTags(),
      loadTechnologies(),
      loadProjects()
    ]);
    
    setupEventListeners();
  }

  async function loadThemes() {
    try {
      themes = await pb.collection("themes").getFullList({ sort: "name" });
      updateThemeSelect();
    } catch (error) {
      console.error("Erreur chargement thèmes:", error);
    }
  }

  async function loadTags() {
    try {
      tags = await pb.collection("tags").getFullList({ sort: "name" });
      updateTagsContainer();
    } catch (error) {
      console.error("Erreur chargement tags:", error);
    }
  }

  async function loadTechnologies() {
    try {
      technologies = await pb.collection("technologies").getFullList({ sort: "name" });
      updateTechnologiesContainer();
    } catch (error) {
      console.error("Erreur chargement technologies:", error);
    }
  }

  async function loadProjects() {
    try {
      projects = await pb.collection("projets").getFullList({
        sort: "-created",
        expand: "theme,tags,technologies",
      });
      renderProjects();
      updateStats();
    } catch (error) {
      console.error("Erreur chargement projets:", error);
    }
  }

  function updateThemeSelect() {
    const select = document.getElementById("project-theme");
    if (select) {
      select.innerHTML = `
        <option value="">Sélectionner un thème</option>
        ${themes.map(theme => `<option value="${theme.id}">${theme.name}</option>`).join('')}
      `;
    }
  }

  function updateTagsContainer() {
    const container = document.getElementById("tags-container");
    if (container) {
      container.innerHTML = tags.map(tag => `
        <label class="flex items-center space-x-2 p-2 bg-[var(--b1)] border border-[var(--bc)]/20 rounded cursor-pointer hover:bg-[var(--b3)]">
          <input type="checkbox" value="${tag.id}" class="checkbox checkbox-xs tag-checkbox" />
          <span class="text-sm text-[var(--bc)]" style="color: ${tag.color || '#000'}">${tag.name}</span>
        </label>
      `).join('');
    }
  }

  function updateTechnologiesContainer() {
    const container = document.getElementById("technologies-container");
    if (container) {
      container.innerHTML = technologies.map(tech => `
        <label class="flex items-center space-x-2 p-2 bg-[var(--b1)] border border-[var(--bc)]/20 rounded cursor-pointer hover:bg-[var(--b3)]">
          <input type="checkbox" value="${tech.id}" class="checkbox checkbox-xs tech-checkbox" />
          <span class="text-sm text-[var(--bc)]">${tech.name}</span>
        </label>
      `).join('');
    }
  }

  function renderProjects() {
    const container = document.getElementById("projects-list");
    if (!container) return;

    if (projects.length === 0) {
      container.innerHTML = `
        <div class="col-span-full text-center py-16">
          <div class="text-6xl mb-4 text-[var(--bc)]/30">📱</div>
          <h3 class="text-xl font-medium text-[var(--bc)] mb-2">Aucun projet</h3>
          <p class="text-[var(--bc)]/70 mb-4">Créez votre premier projet pour commencer</p>
          <button onclick="document.getElementById('new-project-btn').click()" class="btn btn-primary">
            Créer un projet
          </button>
        </div>
      `;
      return;
    }

    container.innerHTML = projects.map(project => {
      const imageUrl = project.hero_image 
        ? pb.files.getUrl(project, project.hero_image, { thumb: "300x200" })
        : null;
      
      const themeName = project.expand?.theme?.name || "Sans thème";
      const tagsHtml = project.expand?.tags?.slice(0, 3).map(tag => 
        `<span class="text-xs px-2 py-1 rounded text-white" style="background-color: ${tag.color || '#000'}">${tag.name}</span>`
      ).join(' ') || '';
      
      const techsHtml = project.expand?.technologies?.slice(0, 3).map(tech => 
        `<span class="text-xs px-2 py-1 bg-[var(--n)] text-[var(--nc)] rounded">${tech.name}</span>`
      ).join(' ') || '';

      return `
        <div class="bg-[var(--b2)] border-4 border-[var(--bc)] hover:shadow-lg transition-all group">
          <!-- Image -->
          <div class="aspect-video bg-[var(--b3)] overflow-hidden relative">
            ${imageUrl 
              ? `<img src="${imageUrl}" alt="${project.title}" class="w-full h-full object-cover" />`
              : `<div class="w-full h-full flex items-center justify-center text-[var(--bc)]/30">
                   <div class="text-center">
                     <div class="text-4xl mb-2">🖼️</div>
                     <div class="text-sm">Aucune image</div>
                   </div>
                 </div>`
            }
            ${project.published 
              ? `<div class="absolute top-2 right-2 badge badge-success">PUBLIÉ</div>`
              : `<div class="absolute top-2 right-2 badge badge-warning">BROUILLON</div>`
            }
          </div>
          
          <!-- Content -->
          <div class="p-4">
            <h3 class="text-lg font-medium text-[var(--bc)] mb-1 group-hover:font-semibold">${project.title}</h3>
            ${project.subtitle ? `<p class="text-sm text-[var(--bc)]/70 mb-2">${project.subtitle}</p>` : ''}
            ${project.description ? `<p class="text-xs text-[var(--bc)]/60 mb-3 line-clamp-2">${project.description}</p>` : ''}
            
            <!-- Theme -->
            <div class="mb-3">
              <span class="text-xs uppercase text-[var(--bc)]/70">Thème:</span>
              <span class="text-xs ml-1 px-2 py-1 bg-[var(--p)] text-[var(--pc)] rounded">${themeName}</span>
            </div>
            
            <!-- Tags -->
            ${tagsHtml ? `
              <div class="mb-2">
                <div class="text-xs uppercase text-[var(--bc)]/70 mb-1">Tags:</div>
                <div class="flex flex-wrap gap-1">${tagsHtml}</div>
              </div>
            ` : ''}
            
            <!-- Technologies -->
            ${techsHtml ? `
              <div class="mb-4">
                <div class="text-xs uppercase text-[var(--bc)]/70 mb-1">Technologies:</div>
                <div class="flex flex-wrap gap-1">${techsHtml}</div>
              </div>
            ` : ''}
            
            <!-- Actions -->
            <div class="flex gap-2">
              <button onclick="editProject('${project.id}')" class="btn btn-primary btn-sm flex-1 uppercase">
                Modifier
              </button>
              <button onclick="duplicateProject('${project.id}')" class="btn btn-outline btn-sm">
                Dupliquer
              </button>
              <button onclick="deleteProject('${project.id}', '${project.title}')" class="btn btn-error btn-sm">
                Supprimer
              </button>
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  function updateStats() {
    const total = projects.length;
    const published = projects.filter(p => p.published).length;
    const drafts = total - published;
    
    document.getElementById("stat-total")!.textContent = total.toString();
    document.getElementById("stat-published")!.textContent = published.toString();
    document.getElementById("stat-drafts")!.textContent = drafts.toString();
  }

  function setupEventListeners() {
    // Nouveau projet
    document.getElementById("new-project-btn")?.addEventListener("click", () => {
      openModal();
    });

    // Fermer modal
    document.getElementById("close-modal")?.addEventListener("click", closeModal);
    document.getElementById("cancel-btn")?.addEventListener("click", closeModal);

    // Auto-slug
    document.getElementById("project-title")?.addEventListener("input", (e) => {
      const title = (e.target as HTMLInputElement).value;
      const slug = title.toLowerCase()
        .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9\s-]/g, "")
        .trim().replace(/\s+/g, "-");
      
      const slugInput = document.getElementById("project-slug") as HTMLInputElement;
      if (slugInput && !slugInput.dataset.manual) {
        slugInput.value = slug;
      }
    });

    document.getElementById("project-slug")?.addEventListener("input", (e) => {
      (e.target as HTMLInputElement).dataset.manual = "true";
    });

    // Preview en temps réel
    ["project-title", "project-subtitle", "project-description", "project-theme"].forEach(id => {
      document.getElementById(id)?.addEventListener("input", updatePreview);
    });

    // Formulaire
    document.getElementById("project-form")?.addEventListener("submit", handleSubmit);

    // Déconnexion
    document.getElementById("logout-btn")?.addEventListener("click", () => {
      pb.authStore.clear();
      window.location.href = "/admin";
    });
  }

  function updatePreview() {
    const title = (document.getElementById("project-title") as HTMLInputElement)?.value || "Titre du projet";
    const subtitle = (document.getElementById("project-subtitle") as HTMLInputElement)?.value || "";
    const description = (document.getElementById("project-description") as HTMLTextAreaElement)?.value || "";
    const themeId = (document.getElementById("project-theme") as HTMLSelectElement)?.value;
    
    const theme = themes.find(t => t.id === themeId);
    const previewContainer = document.getElementById("project-preview");
    
    if (previewContainer) {
      previewContainer.innerHTML = `
        <div class="h-full flex flex-col" ${theme ? `data-theme="${theme.name}"` : ''}>
          <!-- Hero section simulé -->
          <div class="bg-[var(--b2)] p-6 border-b-4 border-[var(--bc)]">
            <div class="aspect-video bg-[var(--b3)] flex items-center justify-center mb-4 border-2 border-[var(--bc)]">
              <span class="text-[var(--bc)]/50">Image Hero</span>
            </div>
            <h1 class="text-2xl font-bold text-[var(--bc)] uppercase mb-2">${title}</h1>
            ${subtitle ? `<p class="text-[var(--bc)]/70 text-lg mb-4">${subtitle}</p>` : ''}
          </div>
          
          <!-- Contenu -->
          <div class="flex-1 p-6 bg-[var(--b1)]">
            ${description ? `
              <div class="mb-6">
                <h2 class="text-lg font-medium text-[var(--bc)] uppercase mb-3">Description</h2>
                <p class="text-[var(--bc)]/80">${description}</p>
              </div>
            ` : ''}
            
            <div class="mt-6">
              <h2 class="text-lg font-medium text-[var(--bc)] uppercase mb-3">Galerie</h2>
              <div class="grid grid-cols-2 gap-2">
                ${Array(4).fill(0).map(() => `
                  <div class="aspect-square bg-[var(--b2)] border-2 border-[var(--bc)] flex items-center justify-center">
                    <span class="text-[var(--bc)]/50 text-xs">Image</span>
                  </div>
                `).join('')}
              </div>
            </div>
          </div>
          
          <!-- Theme info -->
          <div class="p-3 bg-[var(--b3)] border-t-4 border-[var(--bc)] text-center">
            <span class="text-xs text-[var(--bc)]/70 uppercase">
              Thème: ${theme?.name || 'Aucun thème sélectionné'}
            </span>
          </div>
        </div>
      `;
    }
  }

  function openModal(projectId = null) {
    const isEdit = !!projectId;
    document.getElementById("modal-title")!.textContent = isEdit ? "Modifier le projet" : "Nouveau Projet";
    
    if (isEdit) {
      // Remplir le formulaire avec les données du projet
      // (implémentation similaire à avant)
    } else {
      // Reset du formulaire
      (document.getElementById("project-form") as HTMLFormElement).reset();
      document.getElementById("project-id")!.value = "";
      updatePreview();
    }
    
    document.getElementById("project-modal")?.classList.remove("hidden");
  }

  function closeModal() {
    document.getElementById("project-modal")?.classList.add("hidden");
  }

  async function handleSubmit(e) {
    e.preventDefault();
    // Implémentation de la soumission
    // (similaire à avant mais avec la nouvelle structure)
  }

  // Fonctions globales pour les boutons
  window.editProject = (id) => openModal(id);
  window.duplicateProject = async (id) => {
    // Implémentation duplication
  };
  window.deleteProject = async (id, title) => {
    if (!confirm(`Supprimer "${title}" ?`)) return;
    try {
      await pb.collection("projets").delete(id);
      await loadProjects();
    } catch (error) {
      alert("Erreur lors de la suppression");
    }
  };
</script>
</LayoutAdmin>
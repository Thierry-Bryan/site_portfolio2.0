---
import LayoutAdmin from "../../layouts/LayoutAdmin.astro";
---

<LayoutAdmin title="Admin - Technologies">
  <div id="admin-content" class="hidden">
    <aside
      class="fixed left-0 top-0 h-screen w-64 bg-black text-white flex flex-col z-50"
    >
      <div class="p-6 border-b-2 border-white">
        <h1 class="text-xl font-bold uppercase">Portfolio Admin</h1>
      </div>
      <nav class="flex-1 p-4 space-y-1">
        <a
          href="/admin/dashboard"
          class="block px-4 py-2 hover:bg-white hover:text-black transition-colors uppercase text-sm"
          >Dashboard</a
        >
        <a
          href="/admin/projets"
          class="block px-4 py-2 hover:bg-white hover:text-black transition-colors uppercase text-sm"
          >Projets</a
        >
        <a
          href="/admin/themes"
          class="block px-4 py-2 hover:bg-white hover:text-black transition-colors uppercase text-sm"
          >Thèmes</a
        >
        <a
          href="/admin/tags"
          class="block px-4 py-2 hover:bg-white hover:text-black transition-colors uppercase text-sm"
          >Tags</a
        >
        <a
          href="/admin/technologies"
          class="block px-4 py-2 bg-white text-black uppercase text-sm font-bold"
          >Technologies</a
        >
      </nav>
      <div class="p-4 border-t-2 border-white">
        <button
          id="logout-btn"
          class="w-full px-4 py-2 bg-red-600 hover:bg-red-700 text-white transition-colors uppercase text-sm font-bold"
          >Déconnexion</button
        >
      </div>
    </aside>

    <main class="ml-64 min-h-screen bg-[#faf9f7]">
      <div class="p-8">
        <div class="flex justify-between items-center mb-8">
          <div>
            <h2 class="text-4xl font-bold text-black uppercase mb-2">
              Gestion des technologies
            </h2>
            <p class="text-gray-700">
              Créer et gérer les technologies et outils
            </p>
          </div>
          <button
            id="new-tech-btn"
            class="px-6 py-3 bg-black text-white font-bold uppercase hover:bg-gray-800 transition-colors border-4 border-black"
          >
            Nouvelle technologie
          </button>
        </div>

        <div id="techs-list" class="grid grid-cols-1 md:grid-cols-2 gap-3">
        </div>

        <div
          id="tech-modal"
          class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4"
        >
          <div class="bg-white rounded-lg max-w-md w-full p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6" id="modal-title">
              Nouvelle technologie
            </h2>
            <form id="tech-form" class="space-y-6">
              <input type="hidden" id="tech-id" />
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2"
                  >Nom <span class="text-red-500">*</span></label
                >
                <input
                  type="text"
                  id="tech-name"
                  required
                  placeholder="Ex: React"
                  class="w-full px-4 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-blue-500"
                />
              </div>
              <div class="flex justify-end gap-3">
                <button
                  type="button"
                  id="cancel-btn"
                  class="px-6 py-2 border border-gray-300 rounded hover:bg-gray-100"
                >
                  Annuler
                </button>
                <button
                  type="submit"
                  class="px-6 py-2 bg-blue-600 text-white rounded hover:bg-blue-700"
                >
                  Enregistrer
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>
  </div>
  <div id="loading" class="min-h-screen flex items-center justify-center">
    <div class="text-2xl font-primary text-[var(--bc)]">Chargement...</div>
  </div>
</LayoutAdmin>

<script>
  import PocketBase from "pocketbase";
  const pb = new PocketBase("https://portfolio.bryan-thierry.fr/");

  if (!pb.authStore.isValid) {
    window.location.href = "/admin";
  } else {
    document.getElementById("loading")?.classList.add("hidden");
    document.getElementById("admin-content")?.classList.remove("hidden");
    loadTechs();
  }

  async function loadTechs() {
    const techs = await pb
      .collection("technologies")
      .getFullList({ sort: "name" });
    const container = document.getElementById("techs-list")!;
    container.innerHTML = techs
      .map(
        (tech) => `
      <div class="bg-white p-4 rounded-lg shadow hover:shadow-md transition-shadow flex justify-between items-center">
        <span class="text-lg font-semibold text-gray-900">${tech.name}</span>
        <div class="flex gap-2">
          <button onclick="editTech('${tech.id}')" class="px-4 py-2 bg-blue-600 text-white text-sm rounded hover:bg-blue-700">Modifier</button>
          <button onclick="deleteTech('${tech.id}', '${tech.name}')" class="px-4 py-2 bg-red-600 text-white text-sm rounded hover:bg-red-700">Supprimer</button>
        </div>
      </div>
    `,
      )
      .join("");
  }

  document.getElementById("new-tech-btn")?.addEventListener("click", () => {
    (document.getElementById("tech-form") as HTMLFormElement).reset();
    (document.getElementById("tech-id") as HTMLInputElement).value = "";
    document.getElementById("modal-title")!.textContent = "NOUVELLE TECHNO";
    document.getElementById("tech-modal")?.classList.remove("hidden");
  });

  document.getElementById("cancel-btn")?.addEventListener("click", () => {
    document.getElementById("tech-modal")?.classList.add("hidden");
  });

  document
    .getElementById("tech-form")
    ?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const id = (document.getElementById("tech-id") as HTMLInputElement).value;
      const name = (document.getElementById("tech-name") as HTMLInputElement)
        .value;

      try {
        if (id) {
          await pb.collection("technologies").update(id, { name });
        } else {
          await pb.collection("technologies").create({ name });
        }
        document.getElementById("tech-modal")?.classList.add("hidden");
        loadTechs();
        alert("Technologie enregistrée !");
      } catch (error) {
        console.error(error);
        alert("Erreur lors de l'enregistrement");
      }
    });

  (window as any).editTech = async (id: string) => {
    const tech = await pb.collection("technologies").getOne(id);
    (document.getElementById("tech-id") as HTMLInputElement).value = id;
    (document.getElementById("tech-name") as HTMLInputElement).value =
      tech.name;
    document.getElementById("modal-title")!.textContent =
      `MODIFIER ${tech.name.toUpperCase()}`;
    document.getElementById("tech-modal")?.classList.remove("hidden");
  };

  (window as any).deleteTech = async (id: string, name: string) => {
    if (!confirm(`Supprimer "${name}" ?`)) return;
    await pb.collection("technologies").delete(id);
    loadTechs();
  };

  document.getElementById("logout-btn")?.addEventListener("click", () => {
    pb.authStore.clear();
    window.location.href = "/admin";
  });
</script>

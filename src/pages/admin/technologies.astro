---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Admin - Technologies" theme="basique">
  <div id="admin-content" class="hidden">
    <section class="min-h-screen bg-[var(--b1)] py-20 px-4">
      <div class="max-w-5xl mx-auto">
        <div class="flex justify-between items-center mb-12">
          <div>
            <a href="/admin/dashboard" class="text-[var(--bc)] font-secondary hover:text-[var(--p)] mb-2 inline-block">
              ← Retour au dashboard
            </a>
            <h1 class="text-5xl font-primary text-[var(--bc)]">GESTION DES TECHNOLOGIES</h1>
          </div>
          <button
            id="new-tech-btn"
            class="px-6 py-3 bg-[var(--p)] text-[var(--b1)] font-primary border-2 border-[var(--bc)]"
          >
            + NOUVELLE TECHNO
          </button>
        </div>

        <div id="techs-list" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>

        <!-- Modal -->
        <div id="tech-modal" class="hidden fixed inset-0 bg-black/80 flex items-center justify-center z-50 p-4">
          <div class="bg-[var(--b1)] border-4 border-[var(--bc)] max-w-md w-full p-8">
            <h2 class="text-3xl font-primary text-[var(--bc)] mb-6" id="modal-title">NOUVELLE TECHNO</h2>
            <form id="tech-form" class="space-y-6">
              <input type="hidden" id="tech-id" />
              <div>
                <label class="block text-[var(--bc)] font-secondary mb-2">Nom *</label>
                <input
                  type="text"
                  id="tech-name"
                  required
                  class="w-full p-3 border-2 border-[var(--bc)] bg-[var(--b1)] text-[var(--bc)] font-secondary"
                />
              </div>
              <div class="flex gap-4">
                <button type="submit" class="flex-1 p-4 bg-[var(--p)] text-[var(--b1)] font-primary border-2 border-[var(--bc)]">
                  ENREGISTRER
                </button>
                <button type="button" id="cancel-btn" class="px-8 p-4 bg-[var(--b1)] text-[var(--bc)] font-primary border-2 border-[var(--bc)]">
                  ANNULER
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>
  </div>
  <div id="loading" class="min-h-screen flex items-center justify-center">
    <div class="text-2xl font-primary text-[var(--bc)]">Chargement...</div>
  </div>
</Layout>

<script>
  import PocketBase from "pocketbase";
  const pb = new PocketBase("https://portfolio.bryan-thierry.fr/");
  
  if (!pb.authStore.isValid) {
    window.location.href = "/admin";
  } else {
    document.getElementById("loading")?.classList.add("hidden");
    document.getElementById("admin-content")?.classList.remove("hidden");
    loadTechs();
  }

  async function loadTechs() {
    const techs = await pb.collection("technologies").getFullList({ sort: "name" });
    const container = document.getElementById("techs-list")!;
    container.innerHTML = techs.map(tech => `
      <div class="border-2 border-[var(--bc)] p-4 bg-[var(--b1)] flex justify-between items-center">
        <span class="text-xl font-primary text-[var(--bc)]">${tech.name}</span>
        <div class="flex gap-2">
          <button onclick="editTech('${tech.id}')" class="px-4 py-2 bg-[var(--p)] text-[var(--b1)] font-primary border-2 border-[var(--bc)]">MODIFIER</button>
          <button onclick="deleteTech('${tech.id}', '${tech.name}')" class="px-4 py-2 bg-red-500 text-white font-primary border-2 border-[var(--bc)]">🗑️</button>
        </div>
      </div>
    `).join('');
  }

  document.getElementById("new-tech-btn")?.addEventListener("click", () => {
    (document.getElementById("tech-form") as HTMLFormElement).reset();
    (document.getElementById("tech-id") as HTMLInputElement).value = "";
    document.getElementById("modal-title")!.textContent = "NOUVELLE TECHNO";
    document.getElementById("tech-modal")?.classList.remove("hidden");
  });

  document.getElementById("cancel-btn")?.addEventListener("click", () => {
    document.getElementById("tech-modal")?.classList.add("hidden");
  });

  document.getElementById("tech-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const id = (document.getElementById("tech-id") as HTMLInputElement).value;
    const name = (document.getElementById("tech-name") as HTMLInputElement).value;
    
    try {
      if (id) {
        await pb.collection("technologies").update(id, { name });
      } else {
        await pb.collection("technologies").create({ name });
      }
      document.getElementById("tech-modal")?.classList.add("hidden");
      loadTechs();
      alert("Technologie enregistrée !");
    } catch (error) {
      console.error(error);
      alert("Erreur lors de l'enregistrement");
    }
  });

  (window as any).editTech = async (id: string) => {
    const tech = await pb.collection("technologies").getOne(id);
    (document.getElementById("tech-id") as HTMLInputElement).value = id;
    (document.getElementById("tech-name") as HTMLInputElement).value = tech.name;
    document.getElementById("modal-title")!.textContent = `MODIFIER ${tech.name.toUpperCase()}`;
    document.getElementById("tech-modal")?.classList.remove("hidden");
  };

  (window as any).deleteTech = async (id: string, name: string) => {
    if (!confirm(`Supprimer "${name}" ?`)) return;
    await pb.collection("technologies").delete(id);
    loadTechs();
    alert("Technologie supprimée !");
  };
</script>
</Layout>

---
// SOLUTION D'URGENCE - Chargement client-side en temps réel
import Layout from "../../layouts/Layout.astro";
import BackgroundComics from "../../components/BackgroundComics.astro";
---

<Layout title="Mes Projets" theme="ca-va-trailer">
  <section class="bg-(--b1) min-h-screen py-30 px-4 md:px-6">
    <BackgroundComics />
    
    <div class="max-w-7xl mx-auto">
      <header class="text-center mb-16">
        <h1 class="text-6xl md:text-8xl font-bold text-(--p) mb-4 font-primary">
          Mes Projets
        </h1>
        <p class="text-xl text-(--bc) opacity-80">
          Découvrez mes réalisations et projets créatifs
        </p>
      </header>

      <!-- Loading State -->
      <div id="loading" class="text-center py-20">
        <div class="animate-spin rounded-full h-16 w-16 border-t-2 border-b-2 border-(--p) mx-auto"></div>
        <p class="mt-4 text-(--bc)">Chargement des projets...</p>
      </div>

      <!-- Filter Buttons -->
      <div id="filters" class="hidden justify-center mb-12">
        <div class="filter-container flex flex-wrap gap-3 justify-center">
          <!-- Buttons will be populated by JavaScript -->
        </div>
      </div>

      <!-- Projects Grid -->
      <div id="projets-grid" class="hidden grid-view">
        <div class="grid-view-content grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Projects will be populated by JavaScript -->
        </div>
      </div>

      <!-- Error State -->
      <div id="error" class="hidden text-center py-20">
        <p class="text-red-500">Erreur lors du chargement des projets.</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Configuration PocketBase
  const POCKETBASE_URL = 'https://pocketbase-portfolio-production.up.railway.app';
  
  // Import PocketBase client
  import('https://cdn.jsdelivr.net/npm/pocketbase@0.21.1/dist/pocketbase.umd.js').then(module => {
    const PocketBase = module.default;
    const pb = new PocketBase(POCKETBASE_URL);
    
    loadProjetsRealTime(pb);
  });

  async function loadProjetsRealTime(pb) {
    try {
      console.log('🔄 Chargement projets en temps réel...');
      
      // Chargement parallèle des données
      const [tagsResponse, projetsResponse] = await Promise.all([
        pb.collection("tags").getFullList({ sort: "name" }),
        pb.collection("projets").getFullList({ 
          sort: "order", 
          expand: "tags,technologies",
          filter: "published = true"
        })
      ]);

      console.log('✅ Projets chargés:', projetsResponse.length);
      
      // Cacher le loading
      document.getElementById('loading').classList.add('hidden');
      
      // Afficher le contenu
      renderProjets(projetsResponse, tagsResponse, pb);
      
    } catch (error) {
      console.error('❌ Erreur:', error);
      document.getElementById('loading').classList.add('hidden');
      document.getElementById('error').classList.remove('hidden');
    }
  }

  function renderProjets(projets, tags, pb) {
    // Rendu des filtres
    renderFilters(tags);
    
    // Rendu des projets
    renderProjetsGrid(projets, pb);
    
    // Afficher l'interface
    document.getElementById('filters').classList.remove('hidden');
    document.getElementById('projets-grid').classList.remove('hidden');
    
    // Initialiser les filtres
    initializeFilters(projets, pb);
  }

  function renderFilters(tags) {
    const filterContainer = document.querySelector('.filter-container');
    const filterOptions = ["Tous", ...tags.map(tag => tag.name)];
    
    filterContainer.innerHTML = filterOptions.map((option, index) => `
      <button 
        class="filter-btn px-6 py-3 border-2 border-(--bc) bg-(--b1) text-(--bc) font-primary transition-all hover:bg-(--p) hover:text-(--b1) ${index === 0 ? 'active bg-(--p) text-(--b1)' : ''}"
        data-type="${option.toLowerCase()}"
      >
        ${option}
      </button>
    `).join('');
  }

  function renderProjetsGrid(projets, pb) {
    const grid = document.querySelector('.grid-view-content');
    
    grid.innerHTML = projets.map(projet => {
      const heroImage = projet.hero_image 
        ? pb.files.getUrl(projet, projet.hero_image)
        : '/images/placeholder.webp';
      
      const tags = projet.expand?.tags || [];
      const tagsStr = tags.map(t => t.name.toLowerCase()).join(' ');
      
      return `
        <article 
          class="projet-card group cursor-pointer relative overflow-hidden rounded-xl bg-(--b2) shadow-xl transition-all duration-300 hover:scale-105 hover:shadow-2xl"
          data-tags-lower="${tagsStr}"
          onclick="window.location.href='/projets/${projet.slug}'"
        >
          <div class="relative">
            <img
              src="${heroImage}"
              alt="${projet.title}"
              class="w-full h-64 object-cover transition-transform duration-300 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
            <h3 class="absolute bottom-4 left-4 text-2xl font-bold text-white font-primary">
              ${projet.title}
            </h3>
          </div>
          
          <div class="p-6">
            <p class="text-(--bc) mb-4 line-clamp-3">
              ${projet.short_description || 'Description à venir...'}
            </p>
            
            ${tags.length > 0 ? `
              <div class="flex flex-wrap gap-2 mb-4">
                ${tags.map(tag => `
                  <span class="px-3 py-1 text-sm bg-(--p) text-(--b1) rounded-full">
                    ${tag.name}
                  </span>
                `).join('')}
              </div>
            ` : ''}
            
            <div class="flex items-center justify-between">
              <span class="text-(--p) font-medium">Voir le projet →</span>
            </div>
          </div>
        </article>
      `;
    }).join('');
  }

  function initializeFilters(projets, pb) {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const projetCards = document.querySelectorAll('.projet-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Update active button
        filterBtns.forEach(b => b.classList.remove('active', 'bg-(--p)', 'text-(--b1)'));
        btn.classList.add('active', 'bg-(--p)', 'text-(--b1)');
        
        const filterType = btn.getAttribute('data-type');
        
        // Filter projects
        projetCards.forEach(card => {
          const cardTags = card.getAttribute('data-tags-lower');
          const match = filterType === 'tous' || cardTags.includes(filterType);
          
          card.style.display = match ? 'block' : 'none';
        });
      });
    });
  }
</script>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .grid-view {
    opacity: 1;
    transform: translateY(0);
    transition: all 0.5s ease;
  }
  
  .projet-card {
    animation: fadeInUp 0.6s ease forwards;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
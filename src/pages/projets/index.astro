---
// SOLUTION D'URGENCE - Chargement temps réel PocketBase
import Layout from "../../layouts/Layout.astro";
import BackgroundComics from "../../components/BackgroundComics.astro";
---

<Layout title="Mes Projets - Temps Réel" theme="ca-va-trailer">
  <section class="bg-(--b1) min-h-screen py-30 px-4 md:px-6">
    <BackgroundComics />
    
    <div class="max-w-7xl mx-auto">
      <header class="text-center mb-16">
        <h1 class="text-6xl md:text-8xl font-bold text-(--p) mb-4 font-primary">
          Mes Projets
        </h1>
        <p class="text-xl text-(--bc) opacity-80">
          🔄 Chargement en temps réel depuis PocketBase
        </p>
      </header>

      <!-- Loading State -->
      <div id="loading" class="text-center py-20">
        <div class="animate-spin rounded-full h-16 w-16 border-t-2 border-b-2 border-(--p) mx-auto"></div>
        <p class="mt-4 text-(--bc)">Connexion à PocketBase...</p>
      </div>

      <!-- Filters -->
      <div id="filters" class="hidden justify-center mb-12">
        <div class="filter-container flex flex-wrap gap-3 justify-center">
        </div>
      </div>

      <!-- Projects Grid -->
      <div id="projets-grid" class="hidden">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="projets-container">
        </div>
      </div>

      <!-- Error State -->
      <div id="error" class="hidden text-center py-20">
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
          <strong>Erreur!</strong> Impossible de charger les projets depuis PocketBase.
          <button onclick="location.reload()" class="block mt-4 mx-auto px-6 py-2 bg-red-600 text-white rounded hover:bg-red-700">
            Réessayer
          </button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const POCKETBASE_URL = 'https://pocketbase-portfolio-production.up.railway.app';
  
  // Charger PocketBase depuis CDN
  const script = document.createElement('script');
  script.src = 'https://cdn.jsdelivr.net/npm/pocketbase@0.21.1/dist/pocketbase.umd.js';
  script.onload = initPocketBase;
  script.onerror = showError;
  document.head.appendChild(script);

  function showError(message = "Erreur de connexion") {
    console.error('❌', message);
    document.getElementById('loading').classList.add('hidden');
    document.getElementById('error').classList.remove('hidden');
  }

  function initPocketBase() {
    console.log('🚀 Initialisation PocketBase...');
    const pb = new PocketBase(POCKETBASE_URL);
    loadProjects(pb);
  }

  async function loadProjects(pb) {
    try {
      console.log('📡 Connexion à:', POCKETBASE_URL);
      
      // Test de connexion
      const healthCheck = await fetch(`${POCKETBASE_URL}/api/health`);
      if (!healthCheck.ok) {
        throw new Error('PocketBase non accessible');
      }
      
      console.log('✅ PocketBase accessible');
      
      // Chargement des données
      const [tags, projects] = await Promise.all([
        pb.collection("tags").getFullList({ sort: "name" }),
        pb.collection("projets").getFullList({ 
          sort: "order", 
          expand: "tags,technologies" 
        })
      ]);

      console.log('📊 Données chargées:', { tags: tags.length, projects: projects.length });
      
      renderProjects(projects, tags, pb);
      
    } catch (error) {
      console.error('💥 Erreur:', error);
      showError(`Erreur: ${error.message}`);
    }
  }

  function renderProjects(projects, tags, pb) {
    // Cacher loading
    document.getElementById('loading').classList.add('hidden');
    
    // Créer filtres
    const filterContainer = document.querySelector('.filter-container');
    const allFilters = ["Tous", ...tags.map(t => t.name)];
    
    filterContainer.innerHTML = allFilters.map((filter, i) => `
      <button 
        class="filter-btn px-6 py-3 border-2 border-(--bc) bg-(--b1) text-(--bc) font-primary transition-all hover:bg-(--p) hover:text-(--b1) ${i === 0 ? 'active bg-(--p) text-(--b1)' : ''}"
        data-filter="${filter.toLowerCase()}"
        onclick="filterProjects('${filter.toLowerCase()}')"
      >
        ${filter}
      </button>
    `).join('');
    
    // Créer grille projets
    const container = document.getElementById('projets-container');
    container.innerHTML = projects.map(project => {
      const imageUrl = project.hero_image 
        ? pb.files.getUrl(project, project.hero_image)
        : '/images/placeholder.webp';
      
      const projectTags = project.expand?.tags || [];
      const tagNames = projectTags.map(t => t.name.toLowerCase()).join(' ');
      
      return `
        <article 
          class="projet-card cursor-pointer bg-(--b2) rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:scale-105"
          data-tags="${tagNames}"
          onclick="window.location.href='/projets/${project.slug}'"
        >
          <div class="relative">
            <img 
              src="${imageUrl}" 
              alt="${project.title}"
              class="w-full h-64 object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
            <h3 class="absolute bottom-4 left-4 text-2xl font-bold text-white">
              ${project.title}
            </h3>
          </div>
          
          <div class="p-6">
            <p class="text-(--bc) mb-4 line-clamp-3">
              ${project.short_description || 'Description à venir...'}
            </p>
            
            ${projectTags.length > 0 ? `
              <div class="flex flex-wrap gap-2 mb-4">
                ${projectTags.map(tag => `
                  <span class="px-3 py-1 text-sm bg-(--p) text-(--b1) rounded-full">
                    ${tag.name}
                  </span>
                `).join('')}
              </div>
            ` : ''}
            
            <div class="text-(--p) font-medium">
              Voir le projet →
            </div>
          </div>
        </article>
      `;
    }).join('');
    
    // Afficher interface
    document.getElementById('filters').classList.remove('hidden');
    document.getElementById('projets-grid').classList.remove('hidden');
    
    console.log('✨ Interface rendue avec succès');
  }

  function filterProjects(filterType) {
    const cards = document.querySelectorAll('.projet-card');
    const buttons = document.querySelectorAll('.filter-btn');
    
    // Update active button
    buttons.forEach(btn => {
      btn.classList.remove('active', 'bg-(--p)', 'text-(--b1)');
      if (btn.dataset.filter === filterType) {
        btn.classList.add('active', 'bg-(--p)', 'text-(--b1)');
      }
    });
    
    // Filter cards
    cards.forEach(card => {
      const cardTags = card.dataset.tags;
      const match = filterType === 'tous' || cardTags.includes(filterType);
      card.style.display = match ? 'block' : 'none';
    });
    
    console.log(`🔍 Filtré par: ${filterType}`);
  }
</script>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .projet-card {
    animation: fadeIn 0.5s ease-in-out;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  #loading {
    animation: pulse 2s infinite;
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }
</style>

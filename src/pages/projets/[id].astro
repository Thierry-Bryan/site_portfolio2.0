---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import BackgroundComics from "../../components/BackgroundComics.astro";
import ArrowButton from "../../components/ArrowButton.astro";
import ProjetBanner from "../../components/ProjetBanner.astro";
import {
  getProjets,
  getProjetBySlug,
  getFileUrl,
  getMultipleFileUrls,
  getNextProjet,
  getPreviousProjet,
  generateThemeCSS,
  pb,
} from "../../utils/pb.ts";

// Générer les routes statiques pour tous les projets
export async function getStaticPaths() {
  const projets = await getProjets();
  return projets.map((projet) => ({
    params: { id: projet.slug },
  }));
}

// Récupérer le slug depuis les paramètres de l'URL
const { id } = Astro.params;

// Récupérer les données du projet
const projet = await getProjetBySlug(id);

// Si le projet n'existe pas, rediriger vers la page d'accueil
if (!projet) {
  return Astro.redirect("/");
}

// Gestion du thème dynamique via PocketBase
const themeExpand = projet.expand?.theme;
// Sécurisation : expand peut être un tableau ou un objet selon le client PB
const themeData = Array.isArray(themeExpand) ? themeExpand[0] : themeExpand;

// Debug log pour le serveur
console.log(
  `[Projet ${projet.slug}] Theme Data:`,
  themeData ? `Found (${themeData.name})` : "Not found, using basique",
);
if (themeData) {
  console.log(
    "CSS Variables keys:",
    Object.keys(themeData.css_variables || {}),
  );
}

const themeName = themeData?.name || "basique";

// GÉNÉRER LE CSS POUR TOUS LES THÈMES (pour la navigation client)
const allProjets = await getProjets();
const allThemes = new Set<any>();
allProjets.forEach((p) => {
  const theme = Array.isArray(p.expand?.theme)
    ? p.expand.theme[0]
    : p.expand?.theme;
  if (theme) allThemes.add(theme);
});

// Générer le CSS pour tous les thèmes disponibles
let dynamicThemeCSS = "";
allThemes.forEach((theme) => {
  dynamicThemeCSS += generateThemeCSS(theme);
});

// NOUVELLE LOGIQUE : Navigation par catégorie

// Récupérer le tag principal du projet actuel
const currentTags = projet.expand?.tags || [];
const primaryTag = currentTags[0]?.name || null;

// Filtrer les projets par même tag
const projetsInSameCategory = primaryTag
  ? allProjets.filter((p) => {
      const pTags = p.expand?.tags || [];
      return pTags.some((tag) => tag.name === primaryTag);
    })
  : allProjets;

// Trouver l'index dans la catégorie
const categoryIndex = projetsInSameCategory.findIndex(
  (p) => p.slug === projet.slug,
);
const totalInCategory = projetsInSameCategory.length;

// Navigation circulaire dans la catégorie
const nextIndex = (categoryIndex + 1) % totalInCategory;
const prevIndex = (categoryIndex - 1 + totalInCategory) % totalInCategory;

const nextProjet = projetsInSameCategory[nextIndex];
const previousProjet = projetsInSameCategory[prevIndex];

// Récupérer les URLs des images
const heroImageUrl = getFileUrl(projet, projet.hero_image);
const imagesUrls = getMultipleFileUrls(projet, "images");

// Récupérer les technologies du projet depuis expand
const projetTechnologies = projet.expand?.technologies || [];

// Préparer l'image Open Graph - utiliser l'image hero du projet
const ogImage = heroImageUrl || "/images/og-image.jpg";
---

<Layout
  theme={themeName as any}
  title={projet.title}
  description={projet.description ||
    `Découvrez ${projet.title}, un projet de ${projet.type}. Réalisé avec passion et expertise en webdesign et développement.`}
  image={ogImage}
  dynamicCSS={dynamicThemeCSS}
>
  <!-- Hero Section -->
  <section
    class="relative h-[calc(120vh-7rem)] flex items-stretch overflow-hidden"
  >
    <!-- Indicateur de catégorie -->
    {
      primaryTag && totalInCategory > 1 && (
        <div class="category-navigation absolute top-20 right-4 md:top-8 md:right-8 z-40">
          <div class="bg-white/10 backdrop-blur-md border border-white/20 px-4 py-2 rounded-lg shadow-lg">
            <span class="text-xs md:text-sm font-semibold text-white/90 tracking-wide">
              {primaryTag.toUpperCase()} ({categoryIndex + 1}/{totalInCategory})
            </span>
          </div>
        </div>
      )
    }

    <div class="w-full h-full relative">
      <!-- Zone gauche : Texte sur fond avec angle prononcé (desktop uniquement) -->
      <div
        class="hidden md:flex absolute left-0 top-0 h-full flex-col justify-center pl-12 md:pl-16 lg:pl-20 pr-8 py-12 w-[35%] min-w-[340px] z-30"
      >
        <div class="absolute inset-0 -z-10 shadow-left clip-hero-left"></div>
        <h1
          class="hero-title text-4xl md:text-5xl lg:text-7xl mb-5 md:mb-6 leading-[0.95] transition-colors duration-700 text-color-p transform-rotate-title"
        >
          {projet.title}
        </h1>
        <p
          class="hero-description text-sm md:text-base lg:text-lg font-medium max-w-md leading-relaxed transition-colors duration-700 text-color-bc"
        >
          {projet.hero_description}
        </p>
      </div>

      <!-- Zone centrale : comics + device (desktop uniquement) -->
      <div
        class="hidden md:flex absolute left-[38%] top-0 h-full items-center justify-center w-[60%] z-20 clip-hero-center"
        id="hero-center"
      >
        <!-- Background pattern comics -->
        <div
          class="absolute inset-0 w-full h-full overflow-visible transition-all duration-700"
          id="background-comics"
        >
          <BackgroundComics theme={themeName as any} />
        </div>
      </div>

      <!-- Background comics plein écran mobile uniquement -->
      <div
        class="md:hidden absolute inset-0 w-full h-full overflow-visible transition-all duration-700 z-10"
        id="background-comics-mobile"
      >
        <BackgroundComics theme={themeName as any} />
      </div>

      <!-- Titre mobile en blanc, positionné en haut -->
      <h1
        class="md:hidden absolute top-32 left-0 right-0 z-30 text-5xl leading-tight text-center px-6 text-white"
      >
        {projet.title}
      </h1>

      <!-- Device image : centrée mobile, décalée desktop -->
      <div
        class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 md:-translate-x-[70px] z-20 md:z-22"
      >
        <img
          src={heroImageUrl}
          alt={projet.title}
          class="block mx-auto w-[100vw] max-w-[420px] max-h-[500px] md:max-h-[280px] lg:max-h-[360px] h-auto transition-opacity duration-500 drop-shadow-hero"
          id="hero-device"
        />
      </div>

      <!-- Zone droite : triangle avec angle prononcé (desktop uniquement) -->
      <div
        class="triangle-right hidden md:block absolute right-0 top-0 h-full w-[25%] min-w-[160px] z-25 pointer-events-none transition-all duration-700 card-bg-p clip-hero-right"
      >
        <div class="absolute inset-0 -z-10 shadow-right clip-triangle-right">
        </div>
      </div>

      <!-- Flèches de navigation : centrées mobile, positionnées desktop -->
      {
        totalInCategory > 1 && (
          <>
            <div
              class="absolute bottom-24 left-8 md:bottom-20 md:left-[35%] z-40 cursor-pointer"
              id="prev-arrow-wrapper"
              data-prev-projet={previousProjet?.slug || ""}
            >
              <ArrowButton
                direction="prev"
                dataAttribute={previousProjet?.slug || ""}
                theme={themeName as any}
              />
            </div>
            <div
              class="absolute bottom-24 right-8 md:bottom-20 md:right-[17%] z-40 cursor-pointer"
              id="next-arrow-wrapper"
              data-next-projet={nextProjet?.slug || ""}
            >
              <ArrowButton
                direction="next"
                dataAttribute={nextProjet?.slug || ""}
                theme={themeName as any}
              />
            </div>
          </>
        )
      }
    </div>
  </section>

  <!-- Bandeau de défilement du nom du projet -->
  <ProjetBanner title={projet.title} theme={themeName as any} />

  <style>
    /* Style pour les flèches désactivées */
    .arrow-wrapper-disabled {
      opacity: 0.3 !important;
      pointer-events: none !important;
      cursor: not-allowed !important;
    }

    .arrow-wrapper-disabled button {
      opacity: 0.5 !important;
    }

    .arrow-wrapper-disabled svg {
      opacity: 0.6 !important;
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const currentTheme =
        document.documentElement.dataset.currentTheme || "ca-va-trailer";
      const allProjetsData = JSON.parse(
        document.documentElement.dataset.allProjets || "[]",
      );

      // Fonction pour générer la map de projets avec navigation circulaire
      function generateProjetsData(allProjets) {
        const projetsData = {};

        allProjets.forEach((p, index) => {
          const currentTags = p.tags || [];
          const primaryTag =
            currentTags.length > 0 ? currentTags[0].name : null;

          const projetsInSameCategory = primaryTag
            ? allProjets.filter((proj) => {
                const pTags = proj.tags || [];
                return pTags.some((tag) => tag.name === primaryTag);
              })
            : allProjets;

          const categoryIndex = projetsInSameCategory.findIndex(
            (proj) => proj.slug === p.slug,
          );
          const categoryTotal = projetsInSameCategory.length;

          const prevIndex =
            categoryIndex > 0 ? categoryIndex - 1 : categoryTotal - 1;
          const nextIndex =
            categoryIndex < categoryTotal - 1 ? categoryIndex + 1 : 0;

          projetsData[p.slug] = {
            ...p,
            primaryTag: primaryTag,
            prevId: projetsInSameCategory[prevIndex]?.slug,
            nextId: projetsInSameCategory[nextIndex]?.slug,
          };
        });

        return projetsData;
      }

      // Générer projetsData avec navigation circulaire
      const projetsData = generateProjetsData(allProjetsData);

      // Initialiser le thème du projet
      initializeProjetTheme(currentTheme);

      // Fonction pour initialiser le thème de la page projet
      function initializeProjetTheme(currentTheme) {
        const htmlElement = document.documentElement;
        const themeToApply = currentTheme;
        htmlElement.setAttribute("data-theme", themeToApply);

        // Mettre à jour le data-theme du header et footer avec le thème du projet
        const header = document.getElementById("header");
        const footer = document.querySelector("footer");

        if (header) {
          header.setAttribute("data-theme", themeToApply);
          // Forcer la mise à jour immédiate du background du header
          setTimeout(() => {
            try {
              const headerComputedStyle = getComputedStyle(header);
              const bgColor = headerComputedStyle
                .getPropertyValue("--b1")
                .trim();
              if (bgColor) header.style.backgroundColor = `${bgColor}f5`;
            } catch (e) {}
          }, 10);
        }

        if (footer) footer.setAttribute("data-theme", themeToApply);

        // Mettre à jour la section contenu
        const contenuSection = document.getElementById("contenu");
        if (contenuSection)
          contenuSection.setAttribute("data-theme", themeToApply);

        // Mettre à jour le bandeau défilant
        const projetBanner = document.getElementById("projet-banner");
        if (projetBanner) projetBanner.setAttribute("data-theme", themeToApply);

        // Mettre à jour les flèches
        updateArrowsTheme(themeToApply);
      }

      // Met à jour le thème des flèches de navigation
      function updateArrowsTheme(themeToApply) {
        const prevArrowWrapper = document.getElementById("prev-arrow-wrapper");
        const nextArrowWrapper = document.getElementById("next-arrow-wrapper");

        if (prevArrowWrapper) {
          const prevButton = prevArrowWrapper.querySelector("button");
          if (prevButton) prevButton.setAttribute("data-theme", themeToApply);
        }

        if (nextArrowWrapper) {
          const nextButton = nextArrowWrapper.querySelector("button");
          if (nextButton) nextButton.setAttribute("data-theme", themeToApply);
        }
      }

      // Navigation fluide vers un projet avec animation et changement de thème
      async function navigateToProject(projectSlug) {
        const project = projetsData[projectSlug];
        if (!project) return;

        const heroDevice = document.getElementById("hero-device");
        if (!heroDevice) {
          // Fallback vers navigation classique si pas d'éléments hero
          window.location.href = `/projets/${projectSlug}`;
          return;
        }

        // Animation de sortie fluide de l'image uniquement
        heroDevice.style.transition = "opacity 0.5s ease";
        heroDevice.style.opacity = "0";
        await new Promise((resolve) => setTimeout(resolve, 500));

        const themeToApply = project.theme;

        // Mise à jour du thème global
        const htmlElement = document.documentElement;
        htmlElement.setAttribute("data-theme", themeToApply);

        // Mettre à jour header et footer
        const header = document.getElementById("header");
        const footer = document.querySelector("footer");

        if (header) header.setAttribute("data-theme", themeToApply);
        if (footer) footer.setAttribute("data-theme", themeToApply);

        // Mise à jour du contenu hero
        heroDevice.src = project.backgroundImage;

        // Desktop title
        const heroTitle = document.querySelector(".hero-title");
        if (heroTitle) heroTitle.textContent = project.title;

        // Mobile title
        const mobileTitle = document.querySelector("h1.md\\:hidden");
        if (mobileTitle) mobileTitle.textContent = project.title;

        // Desktop description
        const heroDescription = document.querySelector(".hero-description");
        if (heroDescription) heroDescription.textContent = project.description;

        // Mettre à jour la section contenu
        const contenuSection = document.getElementById("contenu");
        if (contenuSection)
          contenuSection.setAttribute("data-theme", themeToApply);

        // Mettre à jour le bandeau défilant
        const projetBanner = document.getElementById("projet-banner");
        if (projetBanner) projetBanner.setAttribute("data-theme", themeToApply);

        // Mettre à jour les flèches
        updateArrowsTheme(themeToApply);

        // Mettre à jour le contenu détaillé du projet
        updateProjectContent(project);

        // Mise à jour de l'URL sans rechargement
        window.history.pushState({}, "", `/projets/${projectSlug}`);
        document.title = `${project.title} - Portfolio Bryan Thierry`;

        // Animation d'entrée de l'image
        await new Promise((resolve) => setTimeout(resolve, 50));
        heroDevice.style.opacity = "1";

        // Re-initialiser les listeners pour les nouvelles flèches
        initNavigationListeners();
      }

      // Fonction pour mettre à jour le contenu détaillé du projet
      function updateProjectContent(project) {
        // Mettre à jour la description complète
        const projetDescription = document.getElementById("projet-description");
        if (projetDescription && project.contentDescription) {
          projetDescription.innerHTML = project.contentDescription;
        }

        // Mettre à jour les technologies
        const projetTechnologies = document.getElementById(
          "projet-technologies",
        );
        if (projetTechnologies && project.technologies) {
          projetTechnologies.innerHTML = "";
          project.technologies.forEach((tech) => {
            const span = document.createElement("span");
            span.className =
              "px-2 py-1 text-xs font-secondary border border-[var(--bc)] text-[var(--bc)]";
            span.textContent = tech.name;
            projetTechnologies.appendChild(span);
          });
        }

        // Mettre à jour les images du projet
        const projetImagesContainer = document.getElementById(
          "projet-images-container",
        );
        if (projetImagesContainer && project.images) {
          projetImagesContainer.innerHTML = "";
          project.images.forEach((image, index) => {
            const div = document.createElement("div");
            const img = document.createElement("img");
            img.src = image;
            img.alt = `${project.title} - Mockup ${index + 1}`;
            img.className = "w-full h-auto object-cover";
            div.appendChild(img);
            projetImagesContainer.appendChild(div);
          });
        }

        // Mettre à jour le bouton "VOIR LE SITE FINAL"
        const projetButtonContainer = document.getElementById(
          "projet-button-container",
        );
        if (project.siteUrl && project.siteUrl.trim()) {
          if (!projetButtonContainer) {
            // Créer le container du bouton s'il n'existe pas
            const buttonContainer = document.createElement("div");
            buttonContainer.id = "projet-button-container";
            buttonContainer.className = "text-center pt-8";

            const button = document.createElement("a");
            button.href = project.siteUrl;
            button.target = "_blank";
            button.className = "btn font-primary text-lg px-8 py-4";
            button.textContent = "VOIR LE SITE FINAL";

            buttonContainer.appendChild(button);

            // Ajouter après la description
            const descriptionParent = projetDescription?.parentNode;
            if (descriptionParent) {
              descriptionParent.appendChild(buttonContainer);
            }
          } else {
            // Mettre à jour le lien existant
            const link = projetButtonContainer.querySelector("a");
            if (link) {
              link.href = project.siteUrl;
            }
            projetButtonContainer.style.display = "block";
          }
        } else {
          // Cacher le bouton s'il n'y a pas d'URL
          if (projetButtonContainer) {
            projetButtonContainer.style.display = "none";
          }
        }
      }

      // Fonction pour initialiser les listeners de navigation
      function initNavigationListeners() {
        const prevButton = document.querySelector(".arrow-prev");
        const nextButton = document.querySelector(".arrow-next");

        if (prevButton && nextButton) {
          const currentSlug = window.location.pathname.split("/").pop();
          const currentProjet = projetsData[currentSlug];

          if (currentProjet) {
            // Supprimer les anciens listeners
            prevButton.replaceWith(prevButton.cloneNode(true));
            nextButton.replaceWith(nextButton.cloneNode(true));

            // Récupérer les nouveaux éléments après clonage
            const newPrevButton = document.querySelector(".arrow-prev");
            const newNextButton = document.querySelector(".arrow-next");

            newPrevButton.addEventListener("click", async (e) => {
              e.preventDefault();
              if (currentProjet.prevId) {
                await navigateToProject(currentProjet.prevId);
              }
            });

            newNextButton.addEventListener("click", async (e) => {
              e.preventDefault();
              if (currentProjet.nextId) {
                await navigateToProject(currentProjet.nextId);
              }
            });
          }
        }
      }

      // Gérer le bouton retour du navigateur
      window.addEventListener("popstate", (event) => {
        if (event.state && event.state.projectSlug) {
          navigateToProject(event.state.projectSlug);
        } else {
          // Recharger la page si pas d'état
          window.location.reload();
        }
      });

      // Mettre à jour les flèches lors d'un changement de thème global
      function handleThemeChange() {
        // Sauvegarder la position de scroll avant les changements
        const scrollPosition = window.scrollY;

        const currentSlug = window.location.pathname.split("/").pop();
        if (projetsData[currentSlug]) {
          const themeToApply = projetsData[currentSlug].theme;
          updateArrowsTheme(themeToApply);
        }

        // Restaurer la position de scroll après les changements
        requestAnimationFrame(() => {
          window.scrollTo(0, scrollPosition);
        });
      }

      // Observer les changements d'attribut data-theme sur documentElement
      const themeObserver = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (
            mutation.type === "attributes" &&
            mutation.attributeName === "data-theme"
          ) {
            // Petit délai pour éviter les conflits avec le système global
            setTimeout(() => handleThemeChange(), 50);
          }
        });
      });

      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });

      // Initialiser les listeners
      initNavigationListeners();
    });
  </script>
  <script
    is:inline
    define:vars={{
      currentTheme: themeName,
      allProjets: allProjets.map((p) => ({
        slug: p.slug,
        theme: p.expand?.theme?.name || "basique",
        backgroundImage: getFileUrl(p, p.hero_image),
        title: p.title.toUpperCase(),
        description: p.hero_description,
        contentDescription: p.content_description,
        images: getMultipleFileUrls(p, "images"),
        siteUrl: p.site_url,
        technologies: p.expand?.technologies || [],
        tags: p.expand?.tags || [],
      })),
    }}
    data-projet-init
  >
    // Stocker les données pour le script
    document.documentElement.dataset.currentTheme = currentTheme;
    document.documentElement.dataset.allProjets = JSON.stringify(allProjets);
  </script>

  <!-- Section Contenu -->
  <section
    id="contenu"
    class="pt-8 pb-35 card-bg-b1 transition-bg-color"
    data-theme={themeName}
  >
    <div class="mx-4 md:mx-8 lg:mx-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <!-- Contenu texte sticky -->
        <div class="lg:sticky lg:top-8">
          <div>
            <div class="flex flex-wrap items-center gap-4 mb-6">
              <h2 class="font-primary text-4xl transform -rotate-1 m-0">
                DESCRIPTION
              </h2>
              <div id="projet-technologies" class="flex flex-wrap gap-2">
                {
                  projet.expand?.technologies &&
                  projet.expand.technologies.length > 0
                    ? projet.expand.technologies.map((tech: any) => (
                        <span class="px-2 py-1 text-xs font-secondary border border-[var(--bc)] text-[var(--bc)]">
                          {tech.name}
                        </span>
                      ))
                    : null
                }
              </div>
            </div>
            <div
              id="projet-description"
              class="text-lg leading-relaxed mb-8 text-color-bc transition-color"
              set:html={projet.content_description}
            />
          </div>

          <!-- Bouton vers le site (si disponible) -->
          {
            projet.site_url && (
              <div id="projet-button-container" class="text-center pt-8">
                <Button
                  href={projet.site_url}
                  className="font-primary text-lg px-8 py-4"
                  theme={projet.theme as any}
                  target="_blank"
                >
                  VOIR LE SITE FINAL
                </Button>
              </div>
            )
          }
        </div>

        <!-- Images du projet -->
        <div id="projet-images-container" class="space-y-8 pb-20">
          {
            imagesUrls.map((image, index) => (
              <div>
                <img
                  src={image}
                  alt={`${projet.title} - Mockup ${index + 1}`}
                  class="w-full h-auto object-cover"
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Layout>

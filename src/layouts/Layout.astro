---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactModal from "../components/ContactModal.astro";
import type { ThemeName } from "../types";
import { siteConfig } from "../config/site.config";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  theme?: ThemeName;
  firstSectionTheme?: ThemeName;
  dynamicCSS?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = "/images/og-image.jpg",
  theme = "basique",
  firstSectionTheme,
  dynamicCSS,
} = Astro.props;

// Construction de l'URL canonique
const canonicalURL = new URL(Astro.url.pathname, siteConfig.url);

// Titre complet pour le SEO
const fullTitle =
  title === siteConfig.title ? title : `${title} - ${siteConfig.name}`;

// URL de l'image Open Graph complète
const ogImage = new URL(image, siteConfig.url);

// Définir le thème initial pour le SSR
const initialTheme = theme;
---

<!doctype html>
<html lang="fr" data-theme={initialTheme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: siteConfig.author.name,
      url: siteConfig.url,
      jobTitle: "Webdesigner & Développeur Front-End",
      sameAs: [
        siteConfig.social.find(s => s.name === 'LinkedIn')?.url,
        siteConfig.social.find(s => s.name === 'Behance')?.url,
        siteConfig.social.find(s => s.name === 'Instagram')?.url
      ].filter(Boolean)
    })}></script>

    <!-- Préchargement des fonts critiques -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="dns-prefetch" href="https://portfolio.bryan-thierry.fr" />

    <!-- Préchargement des assets critiques -->
    <link
      rel="preload"
      as="image"
      href="/avatar/footer.webp"
      fetchpriority="high"
    />

    <!-- CSS Dynamique injecté pour les thèmes personnalisés -->
    {dynamicCSS && <style set:html={dynamicCSS} />}

    <!-- Script critique: applique un thème unique sans mode sombre -->
    <script
      is:inline
      define:vars={{ pageTheme: theme, initialHeaderTheme: firstSectionTheme }}
    >
      (function () {
        const finalTheme = pageTheme;
        document.documentElement.setAttribute("data-theme", finalTheme);
        localStorage.setItem("theme", finalTheme);

        window.changeTheme = function () {
          return document.documentElement.getAttribute("data-theme") || finalTheme;
        };

        window.addEventListener("DOMContentLoaded", function () {
          const header = document.getElementById("header");
          const footer = document.getElementById("footer");
          const themeForHeader = initialHeaderTheme || finalTheme;

          if (header) {
            header.setAttribute("data-theme", themeForHeader);
          }

          if (footer) {
            footer.setAttribute("data-theme", finalTheme);
          }

          const sections = document.querySelectorAll("section[data-theme]");
          sections.forEach((section) => {
            const sectionTheme = section.getAttribute("data-theme");
            if (sectionTheme) section.setAttribute("data-theme", sectionTheme);
          });
        });
      })();
    </script>
  </head>
  <body class="overflow-x-hidden">
    <Header theme={theme} />
    <slot />
    <Footer theme={theme} />
    <ContactModal />
  </body>
</html>

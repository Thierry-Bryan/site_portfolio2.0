---
// Layout spécial pour l'administration - Sans header/footer
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="m-0 p-0">
    <slot />
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    padding: 0;
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue",
      Arial, sans-serif;
    background: #faf9f7;
  }

  * {
    box-sizing: border-box;
  }
</style>

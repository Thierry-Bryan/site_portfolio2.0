---
// Layout spécial pour l'administration - Sans header/footer
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="m-0 p-0">
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <div class="w-64 bg-base-200 border-r border-base-300">
        <div class="p-4">
          <h1 class="text-xl font-bold">Admin</h1>
        </div>
        <nav class="p-4">
          <div class="space-y-2">
            <a href="/admin/dashboard" class="block px-3 py-2 rounded hover:bg-base-300">
              Dashboard
            </a>
            <a href="/admin/projets-simple" class="block px-3 py-2 rounded hover:bg-base-300">
              Projets
            </a>
            <a href="/admin/themes-simple" class="block px-3 py-2 rounded hover:bg-base-300">
              Thèmes
            </a>
            <a href="/admin/tags" class="block px-3 py-2 rounded hover:bg-base-300">
              Tags
            </a>
            <a href="/admin/technologies" class="block px-3 py-2 rounded hover:bg-base-300">
              Technologies
            </a>
            <hr class="border-base-300 my-4">
            <a href="/" class="block px-3 py-2 rounded hover:bg-base-300">
              Retour au site
            </a>
          </div>
        </nav>
      </div>
      
      <!-- Contenu principal -->
      <div class="flex-1 bg-base-100">
        <slot />
      </div>
    </div>
  </body>
</html>

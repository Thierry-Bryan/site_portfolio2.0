---
// Layout spécial pour l'administration - Sans header/footer
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="m-0 p-0">
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <div class="w-64 bg-black text-white border-r-4 border-white">
        <div class="p-6 border-b-4 border-white">
          <h1 class="text-2xl font-black uppercase tracking-wider">Admin</h1>
        </div>
        <nav class="p-4">
          <div class="space-y-1">
            <a href="/admin/dashboard" class="block px-4 py-3 hover:bg-white hover:text-black transition-colors font-bold uppercase text-sm border-2 border-transparent hover:border-white">
              📊 Dashboard
            </a>
            <a href="/admin/projets" class="block px-4 py-3 hover:bg-white hover:text-black transition-colors font-bold uppercase text-sm border-2 border-transparent hover:border-white">
              🚀 Projets
            </a>
            <a href="/admin/themes" class="block px-4 py-3 hover:bg-white hover:text-black transition-colors font-bold uppercase text-sm border-2 border-transparent hover:border-white">
              🎨 Thèmes
            </a>
            <a href="/admin/tags" class="block px-4 py-3 hover:bg-white hover:text-black transition-colors font-bold uppercase text-sm border-2 border-transparent hover:border-white">
              🏷️ Tags
            </a>
            <a href="/admin/technologies" class="block px-4 py-3 hover:bg-white hover:text-black transition-colors font-bold uppercase text-sm border-2 border-transparent hover:border-white">
              💻 Tech
            </a>
            <hr class="border-white/30 my-4">
            <a href="/" class="block px-4 py-3 hover:bg-white hover:text-black transition-colors font-bold uppercase text-sm border-2 border-transparent hover:border-white">
              ← Site
            </a>
          </div>
        </nav>
      </div>
      
      <!-- Contenu principal -->
      <div class="flex-1 bg-base-100">
        <slot />
      </div>
    </div>
  </body>
</html>
